[
  {
    "id": "p0001",
    "text": "一心一意",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "形容心思專一，毫無雜念。",
    "insight": "多用於形容做事專注投入，如：他一心一意準備會考。",
    "textbook": true
  },
  {
    "id": "p0002",
    "text": "水到渠成",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "水流到之處自然成渠，比喻條件成熟，事情自然成功。",
    "insight": "強調累積與時機，如：每天練字，進步便水到渠成。",
    "textbook": false
  },
  {
    "id": "p0003",
    "text": "百發百中",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "每次射箭都命中目標，比喻料事準確或技藝高超。",
    "insight": "出自《戰國策》養由基善射的故事。",
    "textbook": false
  },
  {
    "id": "p0004",
    "text": "光明磊落",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "形容心地坦蕩，行事正大光明。",
    "insight": "常用於稱許人品，如：他做事光明磊落，值得信任。",
    "textbook": false
  },
  {
    "id": "p0005",
    "text": "畫龍點睛",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻作文或說話時，在關鍵處加上精要的一筆，使全體更生動傳神。",
    "insight": "典出張僧繇畫龍點目後龍即飛去的傳說，形容錦上加妙筆。",
    "textbook": true
  },
  {
    "id": "p0006",
    "text": "守株待兔",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻拘泥守舊，妄想不勞而獲。",
    "insight": "出自《韓非子》，農夫因兔撞樹而不再耕作等兔。",
    "textbook": true
  },
  {
    "id": "p0007",
    "text": "井底之蛙",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻見識短淺、眼界狹隘的人。",
    "insight": "出自《莊子》，坐井觀天而自以為天下不過如此。",
    "textbook": true
  },
  {
    "id": "p0008",
    "text": "狐假虎威",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻依仗他人的權勢欺壓別人。",
    "insight": "出自《戰國策》，狐狸借老虎的威風嚇退百獸。",
    "textbook": true
  },
  {
    "id": "p0009",
    "text": "拔苗助長",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻違反事物發展規律，急於求成反而壞事。",
    "insight": "出自《孟子》，宋人怕苗不長而拔高禾苗，結果苗盡枯死。",
    "textbook": true
  },
  {
    "id": "p0010",
    "text": "亡羊補牢",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "羊丟失後修補羊圈，比喻出錯後及時補救，尚不算晚。",
    "insight": "出自《戰國策》，常搭配「猶未晚也」一起使用。",
    "textbook": true
  },
  {
    "id": "p0011",
    "text": "對牛彈琴",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻對不懂道理的人講道理，白費口舌。",
    "insight": "也用來自嘲言者未看清聽眾程度，說了也是白說。",
    "textbook": false
  },
  {
    "id": "p0012",
    "text": "杯弓蛇影",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "把映在酒杯裡的弓影誤看成蛇，比喻疑神疑鬼、自相驚擾。",
    "insight": "常用於形容因誤會而過度緊張的心理狀態。",
    "textbook": false
  },
  {
    "id": "p0013",
    "text": "畫蛇添足",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻多此一舉，反而壞事。",
    "insight": "出自《戰國策》，先畫成蛇者又加畫腳，因而輸掉了酒。",
    "textbook": true
  },
  {
    "id": "p0014",
    "text": "完璧歸趙",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻將原物完好無損地歸還原主。",
    "insight": "出自《史記》藺相如奉璧使秦、機智護寶歸趙的故事。",
    "textbook": true
  },
  {
    "id": "p0015",
    "text": "破釜沉舟",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻下定決心，不留退路，拚死一戰。",
    "insight": "出自《史記》項羽渡河擊秦，砸鍋沉船以示必勝決心。",
    "textbook": true
  },
  {
    "id": "p0016",
    "text": "臥薪嘗膽",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻刻苦自勵，發憤圖強，以雪恥復仇。",
    "insight": "出自越王句踐忍辱負重、終滅吳國的史事。",
    "textbook": true
  },
  {
    "id": "p0017",
    "text": "錦上添花",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "在美好的事物上再添加美好，使更加完美。",
    "insight": "常與「雪中送炭」對舉，強調兩者輕重不同。",
    "textbook": false
  },
  {
    "id": "p0018",
    "text": "雪中送炭",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻在他人急需時給予及時的幫助。",
    "insight": "強調雪天送炭火取暖，比錦上添花更顯情義。",
    "textbook": false
  },
  {
    "id": "p0019",
    "text": "千載難逢",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "形容機會極為難得，千年才可能遇上一次。",
    "insight": "常用來形容珍貴的機會，如：這是千載難逢的良機。",
    "textbook": false
  },
  {
    "id": "p0020",
    "text": "目不轉睛",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "形容注意力高度集中，眼睛都不轉動地盯著看。",
    "insight": "常用於形容看得入神，如：他目不轉睛地看著比賽。",
    "textbook": false
  },
  {
    "id": "p0021",
    "text": "專心致志",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "形容集中精神，一心一意地做某件事。",
    "insight": "出自《孟子》論奕秋教人下棋，二人專注程度不同。",
    "textbook": true
  },
  {
    "id": "p0022",
    "text": "廢寢忘食",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "形容專心努力，連睡覺吃飯都忘記了。",
    "insight": "多用於稱讚人做事投入，如：他廢寢忘食地準備考試。",
    "textbook": false
  },
  {
    "id": "p0023",
    "text": "名列前茅",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "名次排在前面，比喻成績優異、表現突出。",
    "insight": "「前茅」原指古代行軍走在前面舉茅旌的先鋒。",
    "textbook": false
  },
  {
    "id": "p0024",
    "text": "名副其實",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "名稱與實際相符合，一點也不誇張。",
    "insight": "常用來肯定某人某物確實如其名，如：他是名副其實的高手。",
    "textbook": false
  },
  {
    "id": "p0025",
    "text": "半途而廢",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻做事沒有恆心，中途便放棄了。",
    "insight": "出自《禮記》，常與「持之以恆」相對比較。",
    "textbook": true
  },
  {
    "id": "p0026",
    "text": "見異思遷",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "看見別的事物就改變心意，形容意志不堅定。",
    "insight": "常用於批評三分鐘熱度、缺乏定性的人。",
    "textbook": false
  },
  {
    "id": "p0027",
    "text": "三心二意",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "形容猶豫不決，拿不定主意。",
    "insight": "常與「一心一意」對舉，凸顯專注與分心的差別。",
    "textbook": false
  },
  {
    "id": "p0028",
    "text": "全神貫注",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "形容精神高度集中，全部投入在一件事上。",
    "insight": "常用於形容認真做事的狀態，如：他全神貫注地聽講。",
    "textbook": false
  },
  {
    "id": "p0029",
    "text": "恍然大悟",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "形容突然明白了原本不懂的道理。",
    "insight": "常用於情節轉折，如：聽完解釋，他才恍然大悟。",
    "textbook": false
  },
  {
    "id": "p0030",
    "text": "大器晚成",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻能成就大事業的人，往往需要較長時間才能有所成就。",
    "insight": "出自《老子》，常用來鼓勵起步較晚的人不要氣餒。",
    "textbook": false
  },
  {
    "id": "p0031",
    "text": "有志竟成",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "只要有堅定的志向，最終必能成功。",
    "insight": "常與「有志者事竟成」互通，激勵人堅持理想。",
    "textbook": false
  },
  {
    "id": "p0032",
    "text": "精益求精",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "已經很好了，還要求更好，形容不斷追求進步。",
    "insight": "常用於工藝或學問上的自我要求，如：師傅做事精益求精。",
    "textbook": false
  },
  {
    "id": "p0033",
    "text": "循序漸進",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "依照一定的順序，一步步地逐漸推進。",
    "insight": "常用於學習方法，如：讀書要循序漸進，不能貪快。",
    "textbook": false
  },
  {
    "id": "p0034",
    "text": "持之以恆",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "長久堅持下去，不半途而廢。",
    "insight": "常用於勉勵堅持不懈，如：運動要持之以恆才有效果。",
    "textbook": false
  },
  {
    "id": "p0035",
    "text": "集思廣益",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "集合眾人的智慧與意見，以獲得更廣泛的效益。",
    "insight": "常用於會議討論，如：大家集思廣益，找出最佳方案。",
    "textbook": false
  },
  {
    "id": "p0036",
    "text": "群策群力",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "集合眾人的智謀與力量，共同完成任務。",
    "insight": "常用於團隊合作情境，強調集體智慧的重要。",
    "textbook": false
  },
  {
    "id": "p0037",
    "text": "同心協力",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "大家一條心，共同努力。",
    "insight": "常用於團體合作，如：全班同心協力完成布置。",
    "textbook": false
  },
  {
    "id": "p0038",
    "text": "眾志成城",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "眾人齊心，力量便如堅固的城牆一般不可摧毀。",
    "insight": "常用於強調團結的力量，如：眾志成城，共渡難關。",
    "textbook": false
  },
  {
    "id": "p0039",
    "text": "齊心協力",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "大家一致同心，共同出力。",
    "insight": "與「同心協力」意近，常用於合作場合。",
    "textbook": false
  },
  {
    "id": "p0040",
    "text": "手忙腳亂",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "形容做事慌張，動作忙亂而沒有條理。",
    "insight": "常用於臨時出狀況時，如：突然停電讓大家手忙腳亂。",
    "textbook": false
  },
  {
    "id": "p0041",
    "text": "七手八腳",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "形容人多手雜，動作紛亂的樣子。",
    "insight": "常用於眾人一起動手處理事情，如：大家七手八腳搬桌椅。",
    "textbook": false
  },
  {
    "id": "p0042",
    "text": "九牛一毛",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻極大數量中極微小的一部分，微不足道。",
    "insight": "出自司馬遷〈報任少卿書〉，形容自身死生無足輕重。",
    "textbook": false
  },
  {
    "id": "p0043",
    "text": "十全十美",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "形容事物完美無缺，毫無遺憾。",
    "insight": "常用於形容理想境界，如：世上難有十全十美的人。",
    "textbook": false
  },
  {
    "id": "p0044",
    "text": "五花八門",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "形容花樣繁多，變化多端。",
    "insight": "常用於形容種類眾多，如：夜市小吃五花八門。",
    "textbook": false
  },
  {
    "id": "p0045",
    "text": "四面楚歌",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻陷入孤立無援、四面受敵的困境。",
    "insight": "出自《史記》項羽被圍垓下，聞四面楚歌聲而知大勢已去。",
    "textbook": true
  },
  {
    "id": "p0046",
    "text": "四通八達",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "形容交通四通八方，十分便利暢通。",
    "insight": "常用於描寫城市或道路網絡，如：這裡交通四通八達。",
    "textbook": false
  },
  {
    "id": "p0047",
    "text": "三顧茅廬",
    "type": "成語",
    "level": "常用",
    "source": "教育部成語典",
    "author": null,
    "origin_work": null,
    "meaning": "比喻竭誠邀請、一再誠懇地拜訪賢才。",
    "insight": "出自劉備三次拜訪諸葛亮於草廬、終獲輔佐的史事。",
    "textbook": true
  },
  {
    "id": "p0048",
    "text": "東施效顰",
    "type": "成語",
    "level": "常用",
