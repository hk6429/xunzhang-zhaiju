<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 280" width="280" height="280">
  <defs>
    <filter id="comic-shadow-dj" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="5" stdDeviation="0" flood-color="#0f172a" flood-opacity="0.8" />
    </filter>
    <linearGradient id="tail-grad-dj" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0%" stop-color="#fda4af"/>
      <stop offset="60%" stop-color="#f43f5e"/>
      <stop offset="100%" stop-color="#ffffff"/>
    </linearGradient>
    <linearGradient id="silk-grad-dj" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="50%" stop-color="#fbcfe8"/>
      <stop offset="100%" stop-color="#db2777"/>
    </linearGradient>
    <linearGradient id="skin-dj" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff1f2"/>
      <stop offset="100%" stop-color="#fed7aa"/>
    </linearGradient>
  </defs>

  <!-- Blue Panic Lines -->
  <g stroke="#38bdf8" stroke-width="2" opacity="0.4">
    <line x1="40" y1="20" x2="40" y2="80"/>
    <line x1="240" y1="20" x2="240" y2="80"/>
  </g>

  <!-- Tangled Tails Clamped in an Array Box / Trap at Bottom (尾巴被夾住！) -->
  <g id="nine-tails-trapped" filter="url(#comic-shadow-dj)">
    <!-- Tails tied in a knot -->
    <path d="M 120 180 Q 90 120 110 90 Q 140 140 130 180" fill="url(#tail-grad-dj)" stroke="#0f172a" stroke-width="3"/>
    <path d="M 150 180 Q 180 120 160 90 Q 130 140 140 180" fill="url(#tail-grad-dj)" stroke="#0f172a" stroke-width="3"/>
    <path d="M 130 180 Q 140 120 150 180" fill="url(#tail-grad-dj)" stroke="#0f172a" stroke-width="3"/>
    <!-- Array Trap Clamps on Tails -->
    <g transform="translate(140, 70)" filter="url(#comic-shadow-dj)">
      <rect x="-24" y="-12" width="48" height="24" rx="4" fill="#0284c7" stroke="#0f172a" stroke-width="3"/>
      <text x="0" y="5" font-family="'Noto Serif TC', serif" font-weight="900" font-size="14" fill="#ffffff" text-anchor="middle">禁</text>
    </g>
  </g>

  <!-- Body -->
  <g id="body" filter="url(#comic-shadow-dj)">
    <path d="M 105 165 L 85 240 Q 140 255 195 240 L 175 165 Z" fill="url(#silk-grad-dj)" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <path d="M 95 190 Q 140 205 185 190 L 180 205 Q 140 220 100 205 Z" fill="#db2777" stroke="#0f172a" stroke-width="3.5"/>
    <circle cx="140" cy="200" r="7" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
    <ellipse cx="115" cy="245" rx="12" ry="6" fill="#0f172a"/>
    <ellipse cx="165" cy="245" rx="12" ry="6" fill="#0f172a"/>
  </g>

  <!-- Arms Flailing in Panic -->
  <g id="arms" filter="url(#comic-shadow-dj)">
    <path d="M 100 170 Q 60 145 75 115" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 100 170 Q 60 145 75 115" stroke="#fbcfe8" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="75" cy="115" r="6.5" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>

    <path d="M 175 170 Q 215 145 200 115" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 175 170 Q 215 145 200 115" stroke="#fbcfe8" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="200" cy="115" r="6.5" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Head Base (Drooping Fox Ears) -->
  <g id="hair-back" filter="url(#comic-shadow-dj)">
    <ellipse cx="140" cy="100" rx="56" ry="52" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
    <!-- Drooping Left Fox Ear (垂耳) -->
    <g transform="translate(85, 65) rotate(40)">
      <polygon points="0,15 -18,-28 12,-8" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
      <polygon points="0,10 -14,-22 8,-6" fill="#f43f5e"/>
    </g>
    <!-- Drooping Right Fox Ear (垂耳) -->
    <g transform="translate(195, 65) rotate(-40)">
      <polygon points="0,15 18,-28 -12,-8" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
      <polygon points="0,10 14,-22 -8,-6" fill="#f43f5e"/>
    </g>
  </g>

  <!-- Chibi Face -->
  <ellipse cx="140" cy="112" rx="48" ry="42" fill="url(#skin-dj)" stroke="#0f172a" stroke-width="4.5" filter="url(#comic-shadow-dj)"/>

  <!-- Comic Sweat Drops -->
  <g filter="url(#comic-shadow-dj)">
    <path d="M 65 75 Q 55 95 70 100 Q 80 95 72 75 Z" fill="#38bdf8" stroke="#0f172a" stroke-width="2.5"/>
    <path d="M 215 75 Q 225 95 210 100 Q 200 95 208 75 Z" fill="#38bdf8" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Waterfall Tears (漫畫淚奔) -->
  <path d="M 112 118 Q 106 145 102 185" stroke="#38bdf8" stroke-width="6" stroke-linecap="round" fill="none"/>
  <path d="M 168 118 Q 174 145 178 185" stroke="#38bdf8" stroke-width="6" stroke-linecap="round" fill="none"/>

  <!-- Bangs -->
  <path d="M 94 90 Q 112 108 125 94 Q 140 108 155 94 Q 168 108 186 90 Q 140 70 94 90 Z" fill="#0f172a"/>

  <!-- Comic Panic Teary Eyes (Tears brimming / Wide shocked eyes) -->
  <g id="eyes">
    <ellipse cx="118" cy="110" rx="9" ry="9" fill="#ffffff" stroke="#0f172a" stroke-width="3"/>
    <circle cx="118" cy="110" r="3.5" fill="#db2777"/>
    <ellipse cx="162" cy="110" rx="9" ry="9" fill="#ffffff" stroke="#0f172a" stroke-width="3"/>
    <circle cx="162" cy="110" r="3.5" fill="#db2777"/>
  </g>

  <!-- Wavy Brows -->
  <path d="M 104 94 Q 116 102 128 96" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" fill="none"/>
  <path d="M 176 94 Q 164 102 152 96" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" fill="none"/>

  <!-- Open Screaming Wavy Mouth -->
  <path d="M 126 130 Q 133 122 140 130 Q 147 138 154 130" stroke="#0f172a" stroke-width="4" stroke-linecap="round" fill="none"/>
</svg>
