<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 280" width="280" height="280">
  <defs>
    <pattern id="halftone-dj" width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="1.1" fill="#db2777" opacity="0.18"/>
    </pattern>
    <filter id="comic-shadow-dj" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="5" stdDeviation="0" flood-color="#0f172a" flood-opacity="0.8" />
    </filter>
    <filter id="glow-foxfire-dj" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3.5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
    <linearGradient id="tail-grad-dj" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0%" stop-color="#fda4af"/>
      <stop offset="60%" stop-color="#f43f5e"/>
      <stop offset="100%" stop-color="#ffffff"/>
    </linearGradient>
    <linearGradient id="silk-grad-dj" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="50%" stop-color="#fbcfe8"/>
      <stop offset="100%" stop-color="#db2777"/>
    </linearGradient>
    <linearGradient id="skin-dj" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff1f2"/>
      <stop offset="100%" stop-color="#fed7aa"/>
    </linearGradient>
  </defs>

  <!-- Pink Halftone Aura -->
  <circle cx="140" cy="140" r="125" fill="#fdf2f8" opacity="0.6"/>
  <circle cx="140" cy="140" r="115" fill="url(#halftone-dj)"/>

  <!-- Nine Fluffy Fox Tails (九尾狐尾) in Fan Arrangement -->
  <g id="nine-tails" filter="url(#comic-shadow-dj)">
    <!-- Tail 1 (Far Left) -->
    <path d="M 120 180 C 60 180 20 150 15 110 C 25 100 50 120 110 170 Z" fill="url(#tail-grad-dj)" stroke="#0f172a" stroke-width="3"/>
    <!-- Tail 2 -->
    <path d="M 120 180 C 60 160 30 110 35 70 C 50 70 70 100 115 165 Z" fill="url(#tail-grad-dj)" stroke="#0f172a" stroke-width="3"/>
    <!-- Tail 3 -->
    <path d="M 125 180 C 80 140 60 80 75 40 C 90 50 105 85 125 160 Z" fill="url(#tail-grad-dj)" stroke="#0f172a" stroke-width="3"/>
    <!-- Tail 4 (Center Left) -->
    <path d="M 130 175 C 100 120 105 50 125 20 C 135 35 135 75 135 155 Z" fill="url(#tail-grad-dj)" stroke="#0f172a" stroke-width="3"/>
    <!-- Tail 5 (Center Right) -->
    <path d="M 150 175 C 180 120 175 50 155 20 C 145 35 145 75 145 155 Z" fill="url(#tail-grad-dj)" stroke="#0f172a" stroke-width="3"/>
    <!-- Tail 6 -->
    <path d="M 155 180 C 200 140 220 80 205 40 C 190 50 175 85 155 160 Z" fill="url(#tail-grad-dj)" stroke="#0f172a" stroke-width="3"/>
    <!-- Tail 7 -->
    <path d="M 160 180 C 220 160 250 110 245 70 C 230 70 210 100 165 165 Z" fill="url(#tail-grad-dj)" stroke="#0f172a" stroke-width="3"/>
    <!-- Tail 8 (Far Right) -->
    <path d="M 160 180 C 220 180 260 150 265 110 C 255 100 230 120 170 170 Z" fill="url(#tail-grad-dj)" stroke="#0f172a" stroke-width="3"/>
  </g>

  <!-- Ghostly Pink Foxfire (幽冥狐火) floating around -->
  <g filter="url(#glow-foxfire-dj)">
    <g transform="translate(45, 80)">
      <path d="M 0 10 Q -8 0 0 -12 Q 8 0 0 10 Z" fill="#fda4af" stroke="#db2777" stroke-width="1.5"/>
      <circle cx="0" cy="0" r="3" fill="#ffffff"/>
    </g>
    <g transform="translate(235, 80)">
      <path d="M 0 10 Q -8 0 0 -12 Q 8 0 0 10 Z" fill="#fda4af" stroke="#db2777" stroke-width="1.5"/>
      <circle cx="0" cy="0" r="3" fill="#ffffff"/>
    </g>
  </g>

  <!-- Soul-Guiding Palace Lantern (引魂宮燈) on Left Hand -->
  <g id="lantern" transform="translate(60, 150)" filter="url(#comic-shadow-dj)">
    <line x1="0" y1="-25" x2="0" y2="0" stroke="#ca8a04" stroke-width="3"/>
    <!-- Lantern Body -->
    <rect x="-14" y="0" width="28" height="34" rx="6" fill="#fbcfe8" stroke="#0f172a" stroke-width="3"/>
    <rect x="-10" y="4" width="20" height="26" rx="4" fill="#fdf2f8"/>
    <!-- Floating Fox Flame in Lantern -->
    <circle cx="0" cy="17" r="6" fill="#db2777" filter="url(#glow-foxfire-dj)"/>
    <circle cx="0" cy="17" r="2.5" fill="#ffffff"/>
    <!-- Golden Top & Bottom -->
    <path d="M -16 0 L 16 0 L 12 -6 L -12 -6 Z" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
    <path d="M -16 34 L 16 34 L 10 40 L -10 40 Z" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
    <!-- Pink Tassel -->
    <line x1="0" y1="40" x2="0" y2="58" stroke="#db2777" stroke-width="3" stroke-linecap="round"/>
  </g>

  <!-- Body (Pink & Gold Hanfu Dress) -->
  <g id="body" filter="url(#comic-shadow-dj)">
    <!-- Silk Skirt -->
    <path d="M 105 165 L 85 240 Q 140 255 195 240 L 175 165 Z" fill="url(#silk-grad-dj)" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <!-- Flowing Shawl / Ribbon -->
    <path d="M 95 190 Q 140 205 185 190 L 180 205 Q 140 220 100 205 Z" fill="#db2777" stroke="#0f172a" stroke-width="3.5"/>
    <circle cx="140" cy="200" r="7" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
    <!-- Little Feet -->
    <ellipse cx="115" cy="245" rx="12" ry="6" fill="#0f172a"/>
    <ellipse cx="165" cy="245" rx="12" ry="6" fill="#0f172a"/>
  </g>

  <!-- Arms -->
  <g id="arms" filter="url(#comic-shadow-dj)">
    <!-- Left Hand holding lantern string -->
    <path d="M 100 170 Q 75 165 60 145" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 100 170 Q 75 165 60 145" stroke="#fbcfe8" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="60" cy="145" r="6.5" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>

    <!-- Right Hand touching Cheek (Cute & Charming) -->
    <path d="M 175 170 Q 200 155 188 135" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 175 170 Q 200 155 188 135" stroke="#fbcfe8" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="188" cy="135" r="6.5" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Head Base (Black Hair with Fox Ears) -->
  <g id="hair-back" filter="url(#comic-shadow-dj)">
    <ellipse cx="140" cy="100" rx="56" ry="52" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
    <!-- Left Fox Ear -->
    <g transform="translate(90, 50) rotate(-20)">
      <polygon points="0,15 -18,-28 12,-8" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
      <polygon points="0,10 -14,-22 8,-6" fill="#f43f5e"/>
      <polygon points="0,8 -10,-18 4,-4" fill="#fbcfe8"/>
    </g>
    <!-- Right Fox Ear -->
    <g transform="translate(190, 50) rotate(20)">
      <polygon points="0,15 18,-28 -12,-8" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
      <polygon points="0,10 14,-22 -8,-6" fill="#f43f5e"/>
      <polygon points="0,8 10,-18 -4,-4" fill="#fbcfe8"/>
    </g>
    <!-- Side Hair Locks -->
    <path d="M 85 110 Q 70 160 80 185" stroke="#0f172a" stroke-width="6" stroke-linecap="round" fill="none"/>
    <path d="M 195 110 Q 210 160 200 185" stroke="#0f172a" stroke-width="6" stroke-linecap="round" fill="none"/>
  </g>

  <!-- Cute Chibi Face -->
  <ellipse cx="140" cy="112" rx="48" ry="42" fill="url(#skin-dj)" stroke="#0f172a" stroke-width="4.5" filter="url(#comic-shadow-dj)"/>

  <!-- Golden Phoenix Hair Ornament -->
  <g transform="translate(140, 68)" filter="url(#comic-shadow-dj)">
    <path d="M -15 0 Q 0 -8 15 0 L 0 5 Z" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
    <circle cx="0" cy="2" r="3.5" fill="#ef4444"/>
  </g>

  <!-- Bangs -->
  <path d="M 94 90 Q 112 108 125 94 Q 140 108 155 94 Q 168 108 186 90 Q 140 70 94 90 Z" fill="#0f172a"/>

  <!-- Rosy Cheeks -->
  <ellipse cx="102" cy="124" rx="10" ry="6" fill="#fb7185" opacity="0.75"/>
  <ellipse cx="178" cy="124" rx="10" ry="6" fill="#fb7185" opacity="0.75"/>

  <!-- Big Charming Anime Eyes (Charming & Mischievous wink) -->
  <g id="eyes">
    <!-- Left Eye (Big Sparkling Pink Eye) -->
    <ellipse cx="118" cy="112" rx="11" ry="12" fill="#0f172a"/>
    <circle cx="118" cy="112" r="9" fill="#db2777"/>
    <circle cx="115" cy="108" r="4.5" fill="#ffffff"/>
    <circle cx="122" cy="115" r="2" fill="#ffffff"/>
    <!-- Eyelash / Red Eyeliner -->
    <path d="M 104 100 Q 118 92 130 100" stroke="#db2777" stroke-width="3" stroke-linecap="round" fill="none"/>
    <path d="M 102 102 L 100 96" stroke="#0f172a" stroke-width="3" stroke-linecap="round"/>

    <!-- Right Eye (Playful Wink ^) -->
    <path d="M 152 112 Q 164 98 176 112" stroke="#0f172a" stroke-width="5" stroke-linecap="round" fill="none"/>
    <path d="M 176 110 L 180 105" stroke="#db2777" stroke-width="3" stroke-linecap="round"/>
  </g>

  <!-- Slender Eyebrows -->
  <path d="M 104 94 Q 118 88 128 94" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" fill="none"/>
  <path d="M 176 94 Q 162 88 152 94" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" fill="none"/>

  <!-- Cute Small Nose -->
  <circle cx="140" cy="120" r="2" fill="#fb7185"/>

  <!-- Charming Sly Smile with Red Lipstick -->
  <path d="M 134 128 Q 140 136 148 128" stroke="#0f172a" stroke-width="3" stroke-linecap="round" fill="#e11d48"/>
</svg>
