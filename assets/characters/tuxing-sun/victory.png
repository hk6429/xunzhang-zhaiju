<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 280" width="280" height="280">
  <defs>
    <filter id="comic-shadow-tx" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="5" stdDeviation="0" flood-color="#0f172a" flood-opacity="0.8" />
    </filter>
    <filter id="glow-gold-tx" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="4" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
    <linearGradient id="earth-grad-tx" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#fef08a"/>
      <stop offset="50%" stop-color="#ca8a04"/>
      <stop offset="100%" stop-color="#713f12"/>
    </linearGradient>
    <linearGradient id="skin-tx" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff5f5"/>
      <stop offset="100%" stop-color="#fed7aa"/>
    </linearGradient>
  </defs>

  <!-- Golden Radial Speedlines -->
  <g stroke="#ca8a04" stroke-width="2.5" opacity="0.6" stroke-linecap="round">
    <line x1="140" y1="140" x2="20" y2="20"/>
    <line x1="140" y1="140" x2="80" y2="10"/>
    <line x1="140" y1="140" x2="200" y2="10"/>
    <line x1="140" y1="140" x2="260" y2="25"/>
    <line x1="140" y1="140" x2="270" y2="90"/>
    <line x1="140" y1="140" x2="260" y2="240"/>
    <line x1="140" y1="140" x2="20" y2="240"/>
  </g>

  <!-- Dirt Explosion Fountain at Bottom (泥土如噴泉迸發！) -->
  <g fill="#854d0e" stroke="#0f172a" stroke-width="2">
    <ellipse cx="140" cy="245" rx="45" ry="12" fill="#713f12"/>
    <!-- Dirt clumps shooting upwards -->
    <circle cx="95" cy="215" r="7"/>
    <circle cx="80" cy="190" r="5"/>
    <circle cx="185" cy="215" r="7"/>
    <circle cx="200" cy="190" r="5"/>
    <circle cx="140" cy="205" r="8"/>
  </g>

  <!-- Spinning Golden Binding-Immortal Rope Circles (金色套索旋轉光環) -->
  <g filter="url(#glow-gold-tx)">
    <ellipse cx="140" cy="120" rx="95" ry="40" fill="none" stroke="#facc15" stroke-width="6" transform="rotate(-15 140 120)"/>
    <ellipse cx="140" cy="120" rx="95" ry="40" fill="none" stroke="#ffffff" stroke-width="2" transform="rotate(-15 140 120)"/>
  </g>

  <!-- Compact Body Leaping High -->
  <g id="body" filter="url(#comic-shadow-tx)">
    <path d="M 110 150 L 95 200 Q 140 210 185 200 L 170 150 Z" fill="url(#earth-grad-tx)" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <path d="M 105 175 Q 140 183 175 175" stroke="#facc15" stroke-width="5" fill="none" stroke-linecap="round"/>
    <!-- Tiny Kicking Boots -->
    <ellipse cx="108" cy="210" rx="12" ry="7" fill="#0f172a" transform="rotate(-20 108 210)"/>
    <ellipse cx="172" cy="210" rx="12" ry="7" fill="#0f172a" transform="rotate(20 172 210)"/>
  </g>

  <!-- Arms Raised (Holding Iron Staff + V-Sign) -->
  <g id="arms" filter="url(#comic-shadow-tx)">
    <!-- Left Hand V-Sign -->
    <path d="M 105 155 Q 75 125 65 95" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 105 155 Q 75 125 65 95" stroke="#ca8a04" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="65" cy="95" r="7" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>
    <line x1="63" y1="90" x2="58" y2="78" stroke="#0f172a" stroke-width="3" stroke-linecap="round"/>
    <line x1="68" y1="90" x2="72" y2="78" stroke="#0f172a" stroke-width="3" stroke-linecap="round"/>

    <!-- Right Hand Raising Staff High -->
    <path d="M 175 155 Q 205 125 215 95" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 175 155 Q 205 125 215 95" stroke="#ca8a04" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="215" cy="95" r="7" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>
    <!-- Staff -->
    <line x1="215" y1="130" x2="225" y2="40" stroke="#334155" stroke-width="6" stroke-linecap="round"/>
    <circle cx="225" cy="40" r="5" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
  </g>

  <!-- Mole Hood -->
  <g id="mole-hood" filter="url(#comic-shadow-tx)">
    <ellipse cx="140" cy="95" rx="58" ry="54" fill="#713f12" stroke="#0f172a" stroke-width="4.5"/>
    <circle cx="85" cy="55" r="14" fill="#854d0e" stroke="#0f172a" stroke-width="3"/>
    <circle cx="85" cy="55" r="7" fill="#fde047"/>
    <circle cx="195" cy="55" r="14" fill="#854d0e" stroke="#0f172a" stroke-width="3"/>
    <circle cx="195" cy="55" r="7" fill="#fde047"/>
  </g>

  <!-- Cute Face -->
  <ellipse cx="140" cy="105" rx="46" ry="40" fill="url(#skin-tx)" stroke="#0f172a" stroke-width="4" filter="url(#comic-shadow-tx)"/>

  <!-- Bangs -->
  <path d="M 98 86 Q 115 100 125 88 Q 140 100 155 88 Q 165 100 182 86 Q 140 70 98 86 Z" fill="#0f172a"/>

  <!-- Big Red Rosy Cheeks -->
  <ellipse cx="100" cy="115" rx="11" ry="7" fill="#fb7185" opacity="0.85"/>
  <ellipse cx="180" cy="115" rx="11" ry="7" fill="#fb7185" opacity="0.85"/>

  <!-- Joyful Curved Laughing Eyes (>< or ^^) -->
  <g id="eyes">
    <path d="M 108 100 Q 120 86 132 100" stroke="#0f172a" stroke-width="5" stroke-linecap="round" fill="none"/>
    <path d="M 148 100 Q 160 86 172 100" stroke="#0f172a" stroke-width="5" stroke-linecap="round" fill="none"/>
  </g>

  <path d="M 104 80 Q 118 72 130 80" stroke="#0f172a" stroke-width="4" stroke-linecap="round" fill="none"/>
  <path d="M 176 80 Q 162 72 150 80" stroke="#0f172a" stroke-width="4" stroke-linecap="round" fill="none"/>

  <circle cx="140" cy="110" r="4" fill="#854d0e" stroke="#0f172a" stroke-width="1.5"/>

  <!-- Big Open Laughing Mouth ("哈哈！俺老土破陣啦！") -->
  <g id="mouth">
    <path d="M 124 118 Q 140 108 156 118 Q 140 144 124 118 Z" fill="#e11d48" stroke="#0f172a" stroke-width="3" stroke-linejoin="round"/>
    <path d="M 130 128 Q 140 120 150 128" fill="#fda4af"/>
  </g>
</svg>
