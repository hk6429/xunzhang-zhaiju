<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 280" width="280" height="280">
  <defs>
    <filter id="comic-shadow-yj" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="5" stdDeviation="0" flood-color="#0f172a" flood-opacity="0.8" />
    </filter>
    <linearGradient id="armor-grad-yj" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="50%" stop-color="#bae6fd"/>
      <stop offset="100%" stop-color="#0284c7"/>
    </linearGradient>
    <linearGradient id="skin-yj" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff5f5"/>
      <stop offset="100%" stop-color="#fed7aa"/>
    </linearGradient>
  </defs>

  <!-- Comic Panic Sweat lines -->
  <g stroke="#38bdf8" stroke-width="2" opacity="0.4">
    <line x1="40" y1="20" x2="40" y2="80"/>
    <line x1="240" y1="20" x2="240" y2="80"/>
  </g>

  <!-- Tug-of-war Cape Stretched out hard to the left -->
  <path d="M 100 175 Q 40 210 20 225 L 45 240 Q 90 200 110 190 Z" fill="#f8fafc" stroke="#0f172a" stroke-width="4"/>

  <!-- Xiaotian Dog Biting Cape and Pulling with all its might! (瘋狂拔河二哈) -->
  <g id="xiaotian-dog" transform="translate(25, 220)" filter="url(#comic-shadow-yj)">
    <!-- Pulling posture -->
    <ellipse cx="-10" cy="10" rx="16" ry="10" fill="#0f172a" transform="rotate(20 -10 10)"/>
    <circle cx="2" cy="0" r="13" fill="#0f172a"/>
    <!-- Determined Biting Face (咬緊牙關) -->
    <polygon points="-8,-12 -4,-22 2,-10" fill="#0f172a"/>
    <polygon points="0,-10 6,-22 10,-12" fill="#0f172a"/>
    <path d="M -4 -2 Q 2 -6 8 -2 L 6 6 L -2 6 Z" fill="#ffffff" stroke="#0f172a" stroke-width="1.5"/>
    <!-- Intense Dog Pulling Eyes (><) -->
    <path d="M -2 -4 L 2 -1 M -2 2 L 2 -1" stroke="#0f172a" stroke-width="2"/>
    <path d="M 6 -4 L 10 -1 M 6 2 L 10 -1" stroke="#0f172a" stroke-width="2"/>
  </g>

  <!-- Body (Pulled to the left off balance) -->
  <g id="body" filter="url(#comic-shadow-yj)">
    <path d="M 105 210 L 85 245 L 125 245 L 140 225 L 155 245 L 195 245 L 175 210 Z" fill="#1e293b" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <path d="M 105 165 L 90 215 Q 140 228 190 215 L 175 165 Z" fill="url(#armor-grad-yj)" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <circle cx="140" cy="188" r="9" fill="#facc15" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Arms Trying to Pull Cape Back from Dog -->
  <g id="arms" filter="url(#comic-shadow-yj)">
    <!-- Left Hand pulling cape back -->
    <path d="M 110 175 Q 80 185 65 200" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 110 175 Q 80 185 65 200" stroke="#bae6fd" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="65" cy="200" r="8" fill="#fed7aa" stroke="#0f172a" stroke-width="3"/>

    <!-- Right Hand flailing in air -->
    <path d="M 175 175 Q 210 160 215 135" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 175 175 Q 210 160 215 135" stroke="#bae6fd" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="215" cy="135" r="8" fill="#fed7aa" stroke="#0f172a" stroke-width="3"/>
  </g>

  <!-- Head Base -->
  <g id="hair-back" filter="url(#comic-shadow-yj)">
    <ellipse cx="140" cy="100" rx="56" ry="52" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
    <path d="M 140 50 C 180 20 220 50 215 95 C 195 70 170 60 140 60 Z" fill="#0f172a" stroke="#0f172a" stroke-width="3"/>
    <path d="M 125 48 L 155 48 L 140 32 Z" fill="#facc15" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Chibi Face -->
  <ellipse cx="140" cy="112" rx="48" ry="42" fill="url(#skin-yj)" stroke="#0f172a" stroke-width="4.5" filter="url(#comic-shadow-yj)"/>

  <!-- Comic Huge Sweat Drops -->
  <g filter="url(#comic-shadow-yj)">
    <path d="M 65 75 Q 55 95 70 100 Q 80 95 72 75 Z" fill="#38bdf8" stroke="#0f172a" stroke-width="2.5"/>
    <path d="M 215 75 Q 225 95 210 100 Q 200 95 208 75 Z" fill="#38bdf8" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Third Eye in Panic (Dizzy/Surprised) -->
  <g transform="translate(140, 84)">
    <circle cx="0" cy="0" r="5" fill="#ffffff" stroke="#0f172a" stroke-width="2"/>
    <circle cx="0" cy="0" r="2" fill="#0f172a"/>
  </g>

  <!-- Bangs -->
  <path d="M 94 88 Q 110 106 122 92 L 140 100 L 158 92 Q 170 106 186 88 Q 140 68 94 88 Z" fill="#0f172a"/>

  <!-- Comic Panic Eyes (Wide Open Shock / Comic Lines) -->
  <g id="eyes">
    <ellipse cx="118" cy="110" rx="9" ry="9" fill="#ffffff" stroke="#0f172a" stroke-width="3"/>
    <circle cx="118" cy="110" r="3.5" fill="#0f172a"/>
    <ellipse cx="162" cy="110" rx="9" ry="9" fill="#ffffff" stroke="#0f172a" stroke-width="3"/>
    <circle cx="162" cy="110" r="3.5" fill="#0f172a"/>
  </g>

  <!-- Angled Panic Eyebrows -->
  <path d="M 102 92 L 126 98" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>
  <path d="M 178 92 L 154 98" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>

  <!-- Screaming Jagged / Wavy Mouth ("哮天住口！") -->
  <path d="M 126 130 Q 133 122 140 130 Q 147 138 154 130" stroke="#0f172a" stroke-width="4" stroke-linecap="round" fill="none"/>
</svg>
