<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 280" width="280" height="280">
  <defs>
    <pattern id="halftone-yj" width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="1.1" fill="#0284c7" opacity="0.18"/>
    </pattern>
    <filter id="comic-shadow-yj" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="5" stdDeviation="0" flood-color="#0f172a" flood-opacity="0.8" />
    </filter>
    <filter id="glow-celestial-yj" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3.5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
    <linearGradient id="armor-grad-yj" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="50%" stop-color="#bae6fd"/>
      <stop offset="100%" stop-color="#0284c7"/>
    </linearGradient>
    <linearGradient id="blade-grad-yj" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#e0f2fe"/>
      <stop offset="50%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#7dd3fc"/>
    </linearGradient>
    <linearGradient id="skin-yj" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff5f5"/>
      <stop offset="100%" stop-color="#fed7aa"/>
    </linearGradient>
  </defs>

  <!-- Cyan/Blue Cool Halftone Background -->
  <circle cx="140" cy="140" r="125" fill="#f0f9ff" opacity="0.6"/>
  <circle cx="140" cy="140" r="115" fill="url(#halftone-yj)"/>

  <!-- Ink Splashes -->
  <path d="M 28 65 Q 15 85 38 90 Z" fill="#0f172a" opacity="0.8"/>
  <circle cx="20" cy="98" r="3.5" fill="#0f172a" opacity="0.7"/>

  <!-- Three-pointed Double-edged Blade (三尖兩刃刀) on Right Back -->
  <g id="spear" filter="url(#comic-shadow-yj)">
    <!-- Spear Pole -->
    <path d="M 220 30 L 220 240" stroke="#ca8a04" stroke-width="5.5" stroke-linecap="round"/>
    <!-- Three Blades Tip -->
    <g transform="translate(220, 30)" filter="url(#glow-celestial-yj)">
      <!-- Center Blade -->
      <path d="M 0 -22 L 8 0 L -8 0 Z" fill="url(#blade-grad-yj)" stroke="#0f172a" stroke-width="2.5"/>
      <!-- Left Hook Blade -->
      <path d="M -8 0 Q -18 -8 -16 -18 Q -10 -10 -4 -4 Z" fill="url(#blade-grad-yj)" stroke="#0f172a" stroke-width="2"/>
      <!-- Right Hook Blade -->
      <path d="M 8 0 Q 18 -8 16 -18 Q 10 -10 4 -4 Z" fill="url(#blade-grad-yj)" stroke="#0f172a" stroke-width="2"/>
      <!-- Dragon Mouth Fitting -->
      <circle cx="0" cy="5" r="7" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
      <!-- Azure Tassel -->
      <path d="M 0 12 L -6 28 M 0 12 L 0 30 M 0 12 L 6 28" stroke="#0284c7" stroke-width="3" stroke-linecap="round"/>
    </g>
  </g>

  <!-- Cool Flowing White Cape Behind -->
  <g filter="url(#comic-shadow-yj)">
    <path d="M 90 170 C 60 190 65 240 85 245 C 95 210 110 190 120 180 Z" fill="#f8fafc" stroke="#0f172a" stroke-width="3.5"/>
    <path d="M 170 170 C 195 190 190 240 175 245 C 165 210 150 190 140 180 Z" fill="#f8fafc" stroke="#0f172a" stroke-width="3.5"/>
  </g>

  <!-- Body (Silver Armor & Blue Sash) -->
  <g id="body" filter="url(#comic-shadow-yj)">
    <!-- Pants -->
    <path d="M 105 210 L 95 245 L 135 245 L 140 225 L 145 245 L 185 245 L 175 210 Z" fill="#1e293b" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <!-- Armor Breastplate -->
    <path d="M 105 165 L 90 215 Q 140 228 190 215 L 175 165 Z" fill="url(#armor-grad-yj)" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <!-- Gold Breastplate Inscription -->
    <circle cx="140" cy="188" r="9" fill="#facc15" stroke="#0f172a" stroke-width="2.5"/>
    <path d="M 102 210 Q 140 220 178 210" stroke="#facc15" stroke-width="4" fill="none"/>
    <!-- Boots -->
    <ellipse cx="112" cy="246" rx="14" ry="6" fill="#0f172a"/>
    <ellipse cx="168" cy="246" rx="14" ry="6" fill="#0f172a"/>
  </g>

  <!-- Arms (Cool Cross-arm or Confident Pose) -->
  <g id="arms" filter="url(#comic-shadow-yj)">
    <!-- Left Hand -->
    <path d="M 98 170 Q 72 195 90 205" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 98 170 Q 72 195 90 205" stroke="#bae6fd" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="90" cy="205" r="7.5" fill="#fed7aa" stroke="#0f172a" stroke-width="3"/>

    <!-- Right Hand resting near belt -->
    <path d="M 182 170 Q 200 190 188 205" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 182 170 Q 200 190 188 205" stroke="#bae6fd" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="188" cy="205" r="7.5" fill="#fed7aa" stroke="#0f172a" stroke-width="3"/>
  </g>

  <!-- Adorable Husky Xiaotian Dog (超萌二哈版哮天犬) on Left Foot! -->
  <g id="xiaotian-dog" transform="translate(62, 210)" filter="url(#comic-shadow-yj)">
    <!-- Tail Wagging -->
    <path d="M -15 8 Q -28 -5 -22 -15 Q -14 -12 -12 2" fill="#0f172a" stroke="#0f172a" stroke-width="2"/>
    <!-- Husky Body -->
    <ellipse cx="0" cy="8" rx="16" ry="12" fill="#0f172a"/>
    <!-- Head -->
    <circle cx="6" cy="-4" r="14" fill="#0f172a"/>
    <ellipse cx="8" cy="-2" rx="10" ry="9" fill="#ffffff"/>
    <!-- Cute Husky Mask (Grey/Black forehead stripes) -->
    <path d="M 4 -16 L 8 -7 L 12 -16 Z" fill="#0f172a"/>
    <!-- Husky Ears -->
    <polygon points="-2,-14 2,-24 8,-12" fill="#0f172a"/>
    <polygon points="6,-12 12,-24 16,-14" fill="#0f172a"/>
    <polygon points="0,-14 3,-20 6,-13" fill="#fb7185"/>
    <polygon points="8,-13 11,-20 14,-14" fill="#fb7185"/>
    <!-- Cute Eyes -->
    <circle cx="4" cy="-4" r="2.5" fill="#38bdf8"/>
    <circle cx="10" cy="-4" r="2.5" fill="#38bdf8"/>
    <circle cx="3.5" cy="-4.5" r="1" fill="#ffffff"/>
    <circle cx="9.5" cy="-4.5" r="1" fill="#ffffff"/>
    <!-- Black Nose -->
    <ellipse cx="7" cy="1" rx="2.5" ry="1.8" fill="#0f172a"/>
    <!-- Happy Dog Tongue Out (吐舌頭) -->
    <path d="M 6 3 Q 8 9 10 3" stroke="#fb7185" stroke-width="3.5" stroke-linecap="round" fill="#fb7185"/>
  </g>

  <!-- Head Base (Hair + Golden Headband Crown) -->
  <g id="hair-back" filter="url(#comic-shadow-yj)">
    <ellipse cx="140" cy="100" rx="56" ry="52" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
    <!-- High Ponytail -->
    <path d="M 140 50 C 175 25 210 50 205 90 C 190 70 165 60 140 60 Z" fill="#0f172a" stroke="#0f172a" stroke-width="3"/>
    <!-- Golden Phoenix Crown Hairpin -->
    <path d="M 125 48 L 155 48 L 140 32 Z" fill="#facc15" stroke="#0f172a" stroke-width="2.5"/>
    <circle cx="140" cy="42" r="3" fill="#ef4444"/>
  </g>

  <!-- Cool Handsome Chibi Face -->
  <ellipse cx="140" cy="112" rx="48" ry="42" fill="url(#skin-yj)" stroke="#0f172a" stroke-width="4.5" filter="url(#comic-shadow-yj)"/>

  <!-- Celestial Third Eye (額間天眼) with Gentle Glow -->
  <g transform="translate(140, 84)" filter="url(#glow-celestial-yj)">
    <path d="M -8 0 Q 0 -6 8 0 Q 0 6 -8 0 Z" fill="#ffffff" stroke="#0f172a" stroke-width="2"/>
    <ellipse cx="0" cy="0" rx="3.5" ry="3.5" fill="#0284c7"/>
    <circle cx="0" cy="0" r="1.5" fill="#fef08a"/>
  </g>

  <!-- Hair Bangs (Sharp & Cool) -->
  <g id="bangs" filter="url(#comic-shadow-yj)">
    <path d="M 94 88 Q 110 106 122 92 L 140 100 L 158 92 Q 170 106 186 88 Q 140 68 94 88 Z" fill="#0f172a"/>
  </g>

  <!-- Rosy Cheeks (Subtle Cool) -->
  <ellipse cx="102" cy="124" rx="8" ry="4" fill="#fb7185" opacity="0.45"/>
  <ellipse cx="178" cy="124" rx="8" ry="4" fill="#fb7185" opacity="0.45"/>

  <!-- Comic Cool Eyes (Sharp, Calm & Handsome) -->
  <g id="eyes">
    <ellipse cx="118" cy="112" rx="10" ry="11" fill="#0f172a"/>
    <circle cx="118" cy="112" r="8" fill="#0369a1"/>
    <circle cx="115" cy="108" r="4" fill="#ffffff"/>
    <circle cx="121" cy="115" r="1.8" fill="#ffffff"/>
    <path d="M 104 102 L 130 102" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>

    <ellipse cx="162" cy="112" rx="10" ry="11" fill="#0f172a"/>
    <circle cx="162" cy="112" r="8" fill="#0369a1"/>
    <circle cx="159" cy="108" r="4" fill="#ffffff"/>
    <circle cx="165" cy="115" r="1.8" fill="#ffffff"/>
    <path d="M 150 102 L 176 102" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>
  </g>

  <!-- Sword Eyebrows (劍眉星目) -->
  <path d="M 100 92 L 128 86" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>
  <path d="M 180 92 L 152 86" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>

  <!-- Small Cool Nose -->
  <circle cx="140" cy="120" r="2.5" fill="#38bdf8"/>

  <!-- Confident Slight Smirk -->
  <path d="M 134 128 Q 142 133 148 127" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" fill="none"/>
</svg>
