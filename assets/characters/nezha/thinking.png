<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 280" width="280" height="280">
  <defs>
    <pattern id="halftone-nz-th" width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="1.1" fill="#e11d48" opacity="0.18"/>
    </pattern>
    <filter id="comic-shadow-nz" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="5" stdDeviation="0" flood-color="#0f172a" flood-opacity="0.8" />
    </filter>
    <filter id="glow-flame-nz" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3.5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
    <linearGradient id="fire-grad-nz" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fde047"/>
      <stop offset="50%" stop-color="#f97316"/>
      <stop offset="100%" stop-color="#dc2626"/>
    </linearGradient>
    <linearGradient id="ribbon-grad-nz" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#fb7185"/>
      <stop offset="50%" stop-color="#e11d48"/>
      <stop offset="100%" stop-color="#9f1239"/>
    </linearGradient>
    <linearGradient id="lotus-robe-nz" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ecfdf5"/>
      <stop offset="100%" stop-color="#a7f3d0"/>
    </linearGradient>
    <linearGradient id="skin-nz" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff1f2"/>
      <stop offset="100%" stop-color="#fed7aa"/>
    </linearGradient>
  </defs>

  <circle cx="140" cy="140" r="125" fill="#fef2f2" opacity="0.6"/>
  <circle cx="140" cy="140" r="115" fill="url(#halftone-nz-th)"/>

  <!-- Comic Thinking Spark / Question Mark -->
  <g transform="translate(210, 65) rotate(15)" filter="url(#glow-flame-nz)">
    <text x="0" y="0" font-family="'Noto Serif TC', serif" font-weight="900" font-size="34" fill="#e11d48">？</text>
    <circle cx="15" cy="-20" r="3" fill="#f97316"/>
    <circle cx="-10" cy="-25" r="2" fill="#f97316"/>
  </g>

  <!-- Flowing Red Ribbon (混天綾) - Back Layer -->
  <g filter="url(#comic-shadow-nz)">
    <path d="M 40 180 C 20 120 60 70 100 80 C 70 100 50 140 75 190 Z" fill="url(#ribbon-grad-nz)" stroke="#0f172a" stroke-width="4"/>
    <path d="M 230 190 C 265 140 235 90 190 85 C 215 110 230 150 205 190 Z" fill="url(#ribbon-grad-nz)" stroke="#0f172a" stroke-width="4"/>
  </g>

  <!-- Wind-Fire Wheels under feet -->
  <g id="wheels" filter="url(#glow-flame-nz)">
    <g transform="translate(110, 245)">
      <circle cx="0" cy="0" r="14" fill="url(#fire-grad-nz)" stroke="#0f172a" stroke-width="3"/>
    </g>
    <g transform="translate(170, 245)">
      <circle cx="0" cy="0" r="14" fill="url(#fire-grad-nz)" stroke="#0f172a" stroke-width="3"/>
    </g>
  </g>

  <!-- Body -->
  <g id="body" filter="url(#comic-shadow-nz)">
    <path d="M 110 200 L 95 240 L 130 240 L 140 215 L 150 240 L 185 240 L 170 200 Z" fill="#e11d48" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <path d="M 115 165 Q 140 180 165 165 L 175 205 Q 140 215 105 205 Z" fill="url(#lotus-robe-nz)" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <path d="M 108 195 Q 140 202 172 195" stroke="#facc15" stroke-width="5" fill="none" stroke-linecap="round"/>
    <circle cx="140" cy="198" r="6" fill="#10b981" stroke="#0f172a" stroke-width="2"/>
  </g>

  <!-- Arms Folded in Deep Thinking / Pouting -->
  <g id="arms-crossed" filter="url(#comic-shadow-nz)">
    <path d="M 105 175 Q 140 195 175 175" stroke="#0f172a" stroke-width="16" stroke-linecap="round" fill="none"/>
    <path d="M 105 175 Q 140 195 175 175" stroke="#a7f3d0" stroke-width="9" stroke-linecap="round" fill="none"/>
    <!-- Folded fists -->
    <circle cx="115" cy="182" r="7" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>
    <circle cx="165" cy="182" r="7" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Red Ribbon Front Loop -->
  <path d="M 65 190 Q 95 235 140 228 Q 185 235 215 190" stroke="url(#ribbon-grad-nz)" stroke-width="8" stroke-linecap="round" fill="none"/>
  <path d="M 65 190 Q 95 235 140 228 Q 185 235 215 190" stroke="#0f172a" stroke-width="2" fill="none"/>

  <!-- Head Base -->
  <g id="hair-back" filter="url(#comic-shadow-nz)">
    <ellipse cx="140" cy="100" rx="56" ry="52" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
    <g transform="translate(80, 55)">
      <circle cx="0" cy="0" r="22" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
      <path d="M -12 12 Q -25 25 -35 20" stroke="#e11d48" stroke-width="4.5" stroke-linecap="round" fill="none"/>
      <circle cx="0" cy="0" r="10" fill="#e11d48" stroke="#0f172a" stroke-width="2"/>
    </g>
    <g transform="translate(200, 55)">
      <circle cx="0" cy="0" r="22" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
      <path d="M 12 12 Q 25 25 35 20" stroke="#e11d48" stroke-width="4.5" stroke-linecap="round" fill="none"/>
      <circle cx="0" cy="0" r="10" fill="#e11d48" stroke="#0f172a" stroke-width="2"/>
    </g>
  </g>

  <!-- Chibi Face -->
  <ellipse cx="140" cy="112" rx="48" ry="42" fill="url(#skin-nz)" stroke="#0f172a" stroke-width="4.5" filter="url(#comic-shadow-nz)"/>

  <!-- Giant Comic Sweat Drop on Left Temple -->
  <g transform="translate(90, 80)" filter="url(#comic-shadow-nz)">
    <path d="M 0 -12 Q -8 0 0 8 Q 8 0 0 -12 Z" fill="#38bdf8" stroke="#0f172a" stroke-width="2"/>
  </g>

  <!-- Cinnabar Mark -->
  <g transform="translate(140, 86)">
    <path d="M 0 -8 Q 6 0 0 8 Q -6 0 0 -8 Z" fill="#e11d48"/>
  </g>

  <!-- Bangs -->
  <path d="M 96 90 Q 115 105 125 92 Q 140 106 155 92 Q 165 105 184 90 Q 140 70 96 90 Z" fill="#0f172a"/>

  <!-- Pouting Cheeks with Red Blush -->
  <ellipse cx="100" cy="124" rx="10" ry="7" fill="#fb7185" opacity="0.8"/>
  <ellipse cx="180" cy="124" rx="10" ry="7" fill="#fb7185" opacity="0.8"/>

  <!-- Comic Thinking Eyes (Glancing upward & sideways annoyed) -->
  <g id="eyes">
    <ellipse cx="118" cy="108" rx="10" ry="11" fill="#0f172a"/>
    <circle cx="118" cy="108" r="8" fill="#dc2626"/>
    <circle cx="122" cy="104" r="4.5" fill="#ffffff"/>
    <!-- Right Eye -->
    <ellipse cx="162" cy="108" rx="10" ry="11" fill="#0f172a"/>
    <circle cx="162" cy="108" r="8" fill="#dc2626"/>
    <circle cx="166" cy="104" r="4.5" fill="#ffffff"/>
  </g>

  <!-- Annoyed / Thinking Brows -->
  <path d="M 102 96 L 126 90" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>
  <path d="M 178 90 L 154 96" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>

  <!-- Pouting / Grumpy W-Mouth (嘟嘴表情) -->
  <path d="M 132 128 Q 136 122 140 128 Q 144 122 148 128" stroke="#0f172a" stroke-width="4" stroke-linecap="round" fill="none"/>
</svg>
