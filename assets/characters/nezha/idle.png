<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 280" width="280" height="280">
  <defs>
    <pattern id="halftone-nz" width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="1.1" fill="#e11d48" opacity="0.18"/>
    </pattern>
    <filter id="comic-shadow-nz" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="5" stdDeviation="0" flood-color="#0f172a" flood-opacity="0.8" />
    </filter>
    <filter id="glow-flame-nz" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3.5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
    <linearGradient id="fire-grad-nz" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fde047"/>
      <stop offset="50%" stop-color="#f97316"/>
      <stop offset="100%" stop-color="#dc2626"/>
    </linearGradient>
    <linearGradient id="ribbon-grad-nz" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#fb7185"/>
      <stop offset="50%" stop-color="#e11d48"/>
      <stop offset="100%" stop-color="#9f1239"/>
    </linearGradient>
    <linearGradient id="lotus-robe-nz" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ecfdf5"/>
      <stop offset="100%" stop-color="#a7f3d0"/>
    </linearGradient>
    <linearGradient id="skin-nz" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff1f2"/>
      <stop offset="100%" stop-color="#fed7aa"/>
    </linearGradient>
  </defs>

  <!-- Fiery Halftone Background -->
  <circle cx="140" cy="140" r="125" fill="#fef2f2" opacity="0.6"/>
  <circle cx="140" cy="140" r="115" fill="url(#halftone-nz)"/>

  <!-- Ink Splashes & Red Flame Sparks -->
  <path d="M 30 70 Q 20 95 45 90 Z" fill="#0f172a" opacity="0.8"/>
  <circle cx="22" cy="105" r="3.5" fill="#0f172a" opacity="0.7"/>
  <circle cx="250" cy="80" r="3.5" fill="#e11d48" opacity="0.7"/>
  <path d="M 240 180 Q 260 190 248 210 Z" fill="#0f172a" opacity="0.8"/>

  <!-- Flowing Red Ribbon (混天綾) - Back Layer -->
  <g filter="url(#comic-shadow-nz)">
    <path d="M 40 180 C 20 120 60 70 100 80 C 70 100 50 140 75 190 Z" fill="url(#ribbon-grad-nz)" stroke="#0f172a" stroke-width="4"/>
    <path d="M 230 190 C 265 140 235 90 190 85 C 215 110 230 150 205 190 Z" fill="url(#ribbon-grad-nz)" stroke="#0f172a" stroke-width="4"/>
  </g>

  <!-- Wind-Fire Wheels (風火輪) under feet -->
  <g id="wheels" filter="url(#glow-flame-nz)">
    <!-- Left Wheel -->
    <g transform="translate(100, 245)">
      <circle cx="0" cy="0" r="15" fill="url(#fire-grad-nz)" stroke="#0f172a" stroke-width="3"/>
      <circle cx="0" cy="0" r="6" fill="#fef08a" stroke="#ca8a04" stroke-width="1.5"/>
      <path d="M -15 0 L 15 0 M 0 -15 L 0 15" stroke="#ca8a04" stroke-width="2"/>
    </g>
    <!-- Right Wheel -->
    <g transform="translate(180, 245)">
      <circle cx="0" cy="0" r="15" fill="url(#fire-grad-nz)" stroke="#0f172a" stroke-width="3"/>
      <circle cx="0" cy="0" r="6" fill="#fef08a" stroke="#ca8a04" stroke-width="1.5"/>
      <path d="M -15 0 L 15 0 M 0 -15 L 0 15" stroke="#ca8a04" stroke-width="2"/>
    </g>
  </g>

  <!-- Body (Lotus Silk Vest & Bloomers) -->
  <g id="body" filter="url(#comic-shadow-nz)">
    <!-- Red Silk Trousers -->
    <path d="M 110 200 L 95 240 L 130 240 L 140 215 L 150 240 L 185 240 L 170 200 Z" fill="#e11d48" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <!-- Jade Green Lotus Vest (蓮花戰甲) -->
    <path d="M 115 165 Q 140 180 165 165 L 175 205 Q 140 215 105 205 Z" fill="url(#lotus-robe-nz)" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <path d="M 140 172 L 140 210" stroke="#059669" stroke-width="3.5" stroke-linecap="round"/>
    <!-- Lotus Petal Trims -->
    <path d="M 105 205 Q 120 218 135 205 Q 150 218 165 205 Q 175 215 180 205" stroke="#0f172a" stroke-width="3.5" fill="none"/>
    <!-- Golden Waist Belt -->
    <path d="M 108 195 Q 140 202 172 195" stroke="#facc15" stroke-width="5" fill="none" stroke-linecap="round"/>
    <circle cx="140" cy="198" r="6" fill="#10b981" stroke="#0f172a" stroke-width="2"/>
  </g>

  <!-- Arms & Weapons -->
  <!-- Left Hand resting on hip (Tsundere pose) -->
  <g id="arm-left" filter="url(#comic-shadow-nz)">
    <path d="M 110 170 Q 75 180 82 205" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 110 170 Q 75 180 82 205" stroke="url(#skin-nz)" stroke-width="6" stroke-linecap="round" fill="none"/>
    <circle cx="82" cy="205" r="7.5" fill="#fed7aa" stroke="#0f172a" stroke-width="3"/>
  </g>

  <!-- Right Hand holding Qiankun-quan (乾坤圈) -->
  <g id="arm-right" filter="url(#comic-shadow-nz)">
    <path d="M 170 170 Q 205 175 202 195" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 170 170 Q 205 175 202 195" stroke="url(#skin-nz)" stroke-width="6" stroke-linecap="round" fill="none"/>
    <circle cx="202" cy="195" r="7.5" fill="#fed7aa" stroke="#0f172a" stroke-width="3"/>
    <!-- Golden Qiankun Ring -->
    <g transform="translate(205, 195) rotate(-20)" filter="url(#glow-flame-nz)">
      <circle cx="0" cy="0" r="22" fill="none" stroke="#0f172a" stroke-width="9"/>
      <circle cx="0" cy="0" r="22" fill="none" stroke="#facc15" stroke-width="5"/>
      <circle cx="0" cy="0" r="16" fill="none" stroke="#ca8a04" stroke-width="1.5"/>
      <!-- Ring Sparkles -->
      <circle cx="16" cy="-16" r="3" fill="#ffffff"/>
    </g>
  </g>

  <!-- Flowing Red Ribbon (混天綾) - Front Layer Swirl -->
  <g filter="url(#comic-shadow-nz)">
    <path d="M 70 190 Q 90 235 140 230 Q 200 235 220 180 Q 200 200 140 195 Q 90 190 70 190 Z" fill="url(#ribbon-grad-nz)" stroke="#0f172a" stroke-width="3.5"/>
  </g>

  <!-- Big Chibi Head (Cute & Mischievous) -->
  <!-- Hair Base (Black with Red Highlights) -->
  <g id="hair-back" filter="url(#comic-shadow-nz)">
    <ellipse cx="140" cy="100" rx="56" ry="52" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
    <!-- Double Bun (雙抓髻) Left -->
    <g transform="translate(80, 55)">
      <circle cx="0" cy="0" r="22" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
      <!-- Red Ribbon Tie -->
      <path d="M -12 12 Q -25 25 -35 20 M -12 12 Q -20 35 -15 45" stroke="#e11d48" stroke-width="4.5" stroke-linecap="round" fill="none"/>
      <circle cx="0" cy="0" r="10" fill="#e11d48" stroke="#0f172a" stroke-width="2"/>
    </g>
    <!-- Double Bun Right -->
    <g transform="translate(200, 55)">
      <circle cx="0" cy="0" r="22" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
      <!-- Red Ribbon Tie -->
      <path d="M 12 12 Q 25 25 35 20 M 12 12 Q 20 35 15 45" stroke="#e11d48" stroke-width="4.5" stroke-linecap="round" fill="none"/>
      <circle cx="0" cy="0" r="10" fill="#e11d48" stroke="#0f172a" stroke-width="2"/>
    </g>
  </g>

  <!-- Cute Chibi Face -->
  <ellipse cx="140" cy="112" rx="48" ry="42" fill="url(#skin-nz)" stroke="#0f172a" stroke-width="4.5" filter="url(#comic-shadow-nz)"/>

  <!-- Red Cinnabar Forehead Mark (硃砂額印) -->
  <g transform="translate(140, 86)" filter="url(#glow-flame-nz)">
    <path d="M 0 -8 Q 6 0 0 8 Q -6 0 0 -8 Z" fill="#e11d48" stroke="#9f1239" stroke-width="1.5"/>
    <circle cx="0" cy="0" r="2" fill="#fef08a"/>
  </g>

  <!-- Forehead Bangs (Front Fringe) -->
  <g id="bangs" filter="url(#comic-shadow-nz)">
    <path d="M 96 90 Q 115 105 125 92 Q 140 106 155 92 Q 165 105 184 90 Q 140 70 96 90 Z" fill="#0f172a"/>
  </g>

  <!-- Rosy Cheeks -->
  <ellipse cx="102" cy="124" rx="10" ry="6" fill="#fb7185" opacity="0.7"/>
  <ellipse cx="178" cy="124" rx="10" ry="6" fill="#fb7185" opacity="0.7"/>

  <!-- Comic Fiery Hot-Blooded Eyes (Idle: Confident & Tsundere Smirk) -->
  <g id="eyes">
    <!-- Left Eye -->
    <ellipse cx="118" cy="112" rx="11" ry="12" fill="#0f172a"/>
    <circle cx="118" cy="112" r="9" fill="#dc2626"/>
    <circle cx="115" cy="108" r="4.5" fill="#ffffff"/>
    <circle cx="121" cy="115" r="2" fill="#ffffff"/>
    <path d="M 104 102 Q 118 96 130 102" stroke="#0f172a" stroke-width="4" stroke-linecap="round" fill="none"/>
    <!-- Right Eye -->
    <ellipse cx="162" cy="112" rx="11" ry="12" fill="#0f172a"/>
    <circle cx="162" cy="112" r="9" fill="#dc2626"/>
    <circle cx="159" cy="108" r="4.5" fill="#ffffff"/>
    <circle cx="165" cy="115" r="2" fill="#ffffff"/>
    <path d="M 150 102 Q 162 96 176 102" stroke="#0f172a" stroke-width="4" stroke-linecap="round" fill="none"/>
  </g>

  <!-- Sharp Confident Eyebrows -->
  <path d="M 102 94 L 128 88" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>
  <path d="M 178 94 L 152 88" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>

  <!-- Small Cute Nose -->
  <circle cx="140" cy="120" r="2.5" fill="#f97316"/>

  <!-- Mischievous Little Fang Smile (傲嬌虎牙笑) -->
  <g id="mouth">
    <path d="M 132 128 Q 140 138 148 128" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" fill="#e11d48"/>
    <!-- Little White Fang -->
    <path d="M 134 128 L 137 133 L 140 128 Z" fill="#ffffff"/>
  </g>
</svg>
