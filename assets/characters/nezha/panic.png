<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 280" width="280" height="280">
  <defs>
    <filter id="comic-shadow-nz" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="5" stdDeviation="0" flood-color="#0f172a" flood-opacity="0.8" />
    </filter>
    <linearGradient id="fire-grad-nz" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fde047"/>
      <stop offset="50%" stop-color="#f97316"/>
      <stop offset="100%" stop-color="#dc2626"/>
    </linearGradient>
    <linearGradient id="ribbon-grad-nz" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#fb7185"/>
      <stop offset="50%" stop-color="#e11d48"/>
      <stop offset="100%" stop-color="#9f1239"/>
    </linearGradient>
    <linearGradient id="skin-nz" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff1f2"/>
      <stop offset="100%" stop-color="#fed7aa"/>
    </linearGradient>
  </defs>

  <!-- Comic Panic Background (Sweat drops & dizzy lines) -->
  <g stroke="#38bdf8" stroke-width="2" opacity="0.4">
    <line x1="40" y1="20" x2="40" y2="80"/>
    <line x1="240" y1="20" x2="240" y2="80"/>
  </g>

  <!-- Wind-Fire Wheels spinning erratically with smoke spirals -->
  <g id="wheels" transform="translate(60, 230) rotate(-45)">
    <circle cx="0" cy="0" r="14" fill="url(#fire-grad-nz)" stroke="#0f172a" stroke-width="3"/>
  </g>
  <g id="wheels2" transform="translate(220, 230) rotate(45)">
    <circle cx="0" cy="0" r="14" fill="url(#fire-grad-nz)" stroke="#0f172a" stroke-width="3"/>
  </g>

  <!-- Tangled Red Ribbon (混天綾打結死結！) Behind & Around -->
  <g filter="url(#comic-shadow-nz)">
    <!-- Knot loops -->
    <path d="M 50 140 C 30 70 120 50 140 100 C 160 50 250 70 230 140 C 210 200 70 200 50 140 Z" fill="none" stroke="url(#ribbon-grad-nz)" stroke-width="12" stroke-linejoin="round"/>
    <path d="M 50 140 C 30 70 120 50 140 100 C 160 50 250 70 230 140 C 210 200 70 200 50 140 Z" fill="none" stroke="#0f172a" stroke-width="3"/>
  </g>

  <!-- Body Tied Up Like a Zongzi (被捆成粽子) -->
  <g id="body" filter="url(#comic-shadow-nz)">
    <path d="M 110 200 L 95 240 L 130 240 L 140 215 L 150 240 L 185 240 L 170 200 Z" fill="#e11d48" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <path d="M 115 165 Q 140 180 165 165 L 175 205 Q 140 215 105 205 Z" fill="#a7f3d0" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    
    <!-- Red Ribbon wound tightly around body -->
    <path d="M 100 175 L 180 185" stroke="url(#ribbon-grad-nz)" stroke-width="8" stroke-linecap="round"/>
    <path d="M 100 175 L 180 185" stroke="#0f172a" stroke-width="2"/>
    <path d="M 102 195 L 178 190" stroke="url(#ribbon-grad-nz)" stroke-width="8" stroke-linecap="round"/>
    <path d="M 102 195 L 178 190" stroke="#0f172a" stroke-width="2"/>
    <path d="M 100 215 L 180 210" stroke="url(#ribbon-grad-nz)" stroke-width="8" stroke-linecap="round"/>
    <path d="M 100 215 L 180 210" stroke="#0f172a" stroke-width="2"/>
  </g>

  <!-- Flailing Tied Arms -->
  <g id="arms" filter="url(#comic-shadow-nz)">
    <!-- Struggling hands popping out of ribbons -->
    <circle cx="95" cy="180" r="7" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>
    <circle cx="185" cy="180" r="7" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Head Base -->
  <g id="hair-back" filter="url(#comic-shadow-nz)">
    <ellipse cx="140" cy="100" rx="56" ry="52" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
    <!-- Bun Left shaken -->
    <g transform="translate(80, 55) rotate(-15)">
      <circle cx="0" cy="0" r="22" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
      <path d="M -12 12 Q -25 25 -35 20" stroke="#e11d48" stroke-width="4.5" stroke-linecap="round" fill="none"/>
    </g>
    <!-- Bun Right shaken -->
    <g transform="translate(200, 55) rotate(15)">
      <circle cx="0" cy="0" r="22" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
      <path d="M 12 12 Q 25 25 35 20" stroke="#e11d48" stroke-width="4.5" stroke-linecap="round" fill="none"/>
    </g>
  </g>

  <!-- Chibi Face -->
  <ellipse cx="140" cy="112" rx="48" ry="42" fill="url(#skin-nz)" stroke="#0f172a" stroke-width="4.5" filter="url(#comic-shadow-nz)"/>

  <!-- Comic Huge Sweat Drops -->
  <g filter="url(#comic-shadow-nz)">
    <path d="M 65 75 Q 55 95 70 100 Q 80 95 72 75 Z" fill="#38bdf8" stroke="#0f172a" stroke-width="2.5"/>
    <path d="M 215 75 Q 225 95 210 100 Q 200 95 208 75 Z" fill="#38bdf8" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Waterfall Comic Tears -->
  <path d="M 112 118 Q 106 145 102 185" stroke="#38bdf8" stroke-width="6" stroke-linecap="round" fill="none"/>
  <path d="M 168 118 Q 174 145 178 185" stroke="#38bdf8" stroke-width="6" stroke-linecap="round" fill="none"/>

  <!-- Cinnabar Mark -->
  <g transform="translate(140, 86)">
    <path d="M 0 -8 Q 6 0 0 8 Q -6 0 0 -8 Z" fill="#e11d48"/>
  </g>

  <!-- Bangs -->
  <path d="M 96 90 Q 115 105 125 92 Q 140 106 155 92 Q 165 105 184 90 Q 140 70 96 90 Z" fill="#0f172a"/>

  <!-- Comic Spiral Dizzy Eyes (@_@) -->
  <g id="eyes">
    <path d="M 118 110 m -9, 0 a 9,9 0 1,0 18,0 a 7,7 0 1,0 -14,0 a 5,5 0 1,0 10,0 a 3,3 0 1,0 -6,0" fill="none" stroke="#0f172a" stroke-width="2.5"/>
    <path d="M 162 110 m -9, 0 a 9,9 0 1,0 18,0 a 7,7 0 1,0 -14,0 a 5,5 0 1,0 10,0 a 3,3 0 1,0 -6,0" fill="none" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Panicked Wavy Eyebrows -->
  <path d="M 102 92 Q 115 102 128 94" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round" fill="none"/>
  <path d="M 152 94 Q 165 102 178 92" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round" fill="none"/>

  <!-- Wavy Screaming Mouth (波浪尖叫嘴) -->
  <path d="M 126 132 Q 133 124 140 132 Q 147 140 154 132" stroke="#0f172a" stroke-width="4" stroke-linecap="round" fill="none"/>
</svg>
