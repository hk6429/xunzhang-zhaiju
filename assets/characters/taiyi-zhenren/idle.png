<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 280" width="280" height="280">
  <defs>
    <pattern id="halftone-ty" width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="1.1" fill="#d97706" opacity="0.18"/>
    </pattern>
    <filter id="comic-shadow-ty" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="5" stdDeviation="0" flood-color="#0f172a" flood-opacity="0.8" />
    </filter>
    <filter id="glow-gold-ty" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3.5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
    <linearGradient id="gourd-grad-ty" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#fef08a"/>
      <stop offset="50%" stop-color="#f59e0b"/>
      <stop offset="100%" stop-color="#b45309"/>
    </linearGradient>
    <linearGradient id="robe-grad-ty" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#fffbeb"/>
      <stop offset="50%" stop-color="#fef3c7"/>
      <stop offset="100%" stop-color="#fde68a"/>
    </linearGradient>
    <linearGradient id="skin-ty" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff5f5"/>
      <stop offset="100%" stop-color="#fed7aa"/>
    </linearGradient>
  </defs>

  <!-- Golden Warm Halftone Aura -->
  <circle cx="140" cy="140" r="125" fill="#fffbeb" opacity="0.6"/>
  <circle cx="140" cy="140" r="115" fill="url(#halftone-ty)"/>

  <!-- Ink Splatters -->
  <path d="M 28 65 Q 15 85 38 90 Z" fill="#0f172a" opacity="0.8"/>
  <circle cx="20" cy="98" r="3.5" fill="#0f172a" opacity="0.7"/>

  <!-- Giant Golden Wine Gourd (金光大酒葫蘆) on Left Back -->
  <g id="wine-gourd" transform="translate(65, 140) rotate(-18)" filter="url(#comic-shadow-ty)">
    <!-- Gourd Strap -->
    <path d="M 15 -60 L 50 40" stroke="#dc2626" stroke-width="4" stroke-linecap="round"/>
    <!-- Top Bulb -->
    <circle cx="0" cy="-35" r="18" fill="url(#gourd-grad-ty)" stroke="#0f172a" stroke-width="3.5"/>
    <rect x="-6" y="-58" width="12" height="12" rx="2" fill="#dc2626" stroke="#0f172a" stroke-width="2"/>
    <!-- Bottom Bulb -->
    <circle cx="0" cy="5" r="28" fill="url(#gourd-grad-ty)" stroke="#0f172a" stroke-width="4"/>
    <!-- Gourd Red Ribbon Tie -->
    <path d="M -12 -18 Q 0 -10 12 -18" stroke="#dc2626" stroke-width="5" fill="none" stroke-linecap="round"/>
    <circle cx="0" cy="-15" r="4" fill="#dc2626"/>
    <!-- "仙" or "酒" Character on Gourd -->
    <text x="0" y="12" font-family="'Noto Serif TC', serif" font-weight="900" font-size="16" fill="#78350f" text-anchor="middle">酒</text>
    <!-- Wine Aroma Smoke (酒香仙氣) -->
    <path d="M 0 -60 Q -15 -80 0 -95 Q 15 -110 5 -120" stroke="#f59e0b" stroke-width="3" fill="none" stroke-linecap="round" stroke-dasharray="3 3"/>
  </g>

  <!-- Taoist Horsetail Whisk (太極拂塵) on Right -->
  <g id="whisk" filter="url(#comic-shadow-ty)">
    <line x1="210" y1="160" x2="235" y2="105" stroke="#78350f" stroke-width="4.5" stroke-linecap="round"/>
    <path d="M 235 105 Q 265 80 250 50 Q 230 75 235 105" fill="#f8fafc" stroke="#0f172a" stroke-width="3"/>
  </g>

  <!-- Giant Chubby Chibi Body (圓滾滾大肚腩仙風道骨) -->
  <g id="body" filter="url(#comic-shadow-ty)">
    <!-- Robe -->
    <ellipse cx="140" cy="205" rx="55" ry="40" fill="url(#robe-grad-ty)" stroke="#0f172a" stroke-width="4.5"/>
    <!-- Red Robe Trims -->
    <path d="M 115 165 L 140 195 L 165 165" fill="#ef4444" stroke="#0f172a" stroke-width="3.5"/>
    <!-- Golden Waist Belt -->
    <path d="M 92 215 Q 140 235 188 215" stroke="#dc2626" stroke-width="7" fill="none" stroke-linecap="round"/>
    <circle cx="140" cy="225" r="8" fill="#facc15" stroke="#0f172a" stroke-width="2.5"/>
    <!-- Little Feet -->
    <ellipse cx="115" cy="245" rx="14" ry="7" fill="#0f172a"/>
    <ellipse cx="165" cy="245" rx="14" ry="7" fill="#0f172a"/>
  </g>

  <!-- Chubby Arms -->
  <g id="arms" filter="url(#comic-shadow-ty)">
    <!-- Left Hand holding wine cup -->
    <path d="M 95 180 Q 70 170 65 150" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 95 180 Q 70 170 65 150" stroke="#fde68a" stroke-width="6" stroke-linecap="round" fill="none"/>
    <circle cx="65" cy="150" r="7.5" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>
    <!-- Mini Jade Wine Cup -->
    <ellipse cx="65" cy="142" rx="7" ry="4" fill="#a7f3d0" stroke="#0f172a" stroke-width="2"/>

    <!-- Right Hand waving whisk -->
    <path d="M 185 180 Q 210 170 215 150" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 185 180 Q 210 170 215 150" stroke="#fde68a" stroke-width="6" stroke-linecap="round" fill="none"/>
    <circle cx="215" cy="150" r="7.5" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Head Base (Chubby Round Face with Taoist Topknot & Gold Crown) -->
  <g id="hair-back" filter="url(#comic-shadow-ty)">
    <!-- Big Hair Base -->
    <ellipse cx="140" cy="105" rx="60" ry="54" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
    <!-- Gold Lotus Taoist Crown (純金五嶽冠) -->
    <path d="M 125 50 L 155 50 L 150 28 L 130 28 Z" fill="#facc15" stroke="#0f172a" stroke-width="3"/>
    <circle cx="140" cy="38" r="4" fill="#dc2626"/>
    <!-- Jade Hairpin through crown -->
    <line x1="110" y1="38" x2="170" y2="38" stroke="#10b981" stroke-width="3.5" stroke-linecap="round"/>
  </g>

  <!-- Big Chubby Smiling Face (福氣大圓臉) -->
  <ellipse cx="140" cy="115" rx="52" ry="46" fill="url(#skin-ty)" stroke="#0f172a" stroke-width="4.5" filter="url(#comic-shadow-ty)"/>

  <!-- Rosy Cheeks (醉酒微醺粉紅腮紅) -->
  <ellipse cx="96" cy="122" rx="11" ry="7" fill="#fb7185" opacity="0.75"/>
  <ellipse cx="184" cy="122" rx="11" ry="7" fill="#fb7185" opacity="0.75"/>

  <!-- Bangs -->
  <path d="M 94 92 Q 115 105 125 94 Q 140 102 155 94 Q 165 105 186 92 Q 140 76 94 92 Z" fill="#0f172a"/>

  <!-- Smiling Crescent Eyes (樂呵呵瞇瞇眼) -->
  <g id="eyes">
    <path d="M 108 108 Q 118 96 128 108" stroke="#0f172a" stroke-width="5" stroke-linecap="round" fill="none"/>
    <path d="M 152 108 Q 162 96 172 108" stroke="#0f172a" stroke-width="5" stroke-linecap="round" fill="none"/>
  </g>

  <!-- Cheerful Graying Eyebrows -->
  <path d="M 102 90 Q 118 84 130 90" stroke="#0f172a" stroke-width="4" stroke-linecap="round" fill="none"/>
  <path d="M 178 90 Q 162 84 150 90" stroke="#0f172a" stroke-width="4" stroke-linecap="round" fill="none"/>

  <!-- Round Red Alcoholic Nose (討喜紅酒糟鼻) -->
  <circle cx="140" cy="116" r="5.5" fill="#f97316" stroke="#0f172a" stroke-width="2"/>

  <!-- Jovial Laughing Mouth with Tooth -->
  <g id="mouth">
    <path d="M 124 126 Q 140 146 156 126 Z" fill="#e11d48" stroke="#0f172a" stroke-width="3"/>
    <rect x="136" y="126" width="8" height="4" rx="1" fill="#ffffff"/>
  </g>

  <!-- Tiny Cute Goatee Beard (逗趣小撮白鬍鬚) -->
  <path d="M 136 148 Q 140 160 144 148 Z" fill="#f8fafc" stroke="#0f172a" stroke-width="2"/>
</svg>
