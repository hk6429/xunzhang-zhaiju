<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 280" width="280" height="280">
  <defs>
    <pattern id="halftone-sg-th" width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="1.1" fill="#7e22ce" opacity="0.18"/>
    </pattern>
    <filter id="comic-shadow-sg" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="5" stdDeviation="0" flood-color="#0f172a" flood-opacity="0.8" />
    </filter>
    <filter id="glow-purple-sg" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3.5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
    <linearGradient id="purple-robe-sg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f3e8ff"/>
      <stop offset="50%" stop-color="#a855f7"/>
      <stop offset="100%" stop-color="#6b21a8"/>
    </linearGradient>
    <linearGradient id="skin-sg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff5f5"/>
      <stop offset="100%" stop-color="#fed7aa"/>
    </linearGradient>
  </defs>

  <circle cx="140" cy="140" r="125" fill="#faf5ff" opacity="0.6"/>
  <circle cx="140" cy="140" r="115" fill="url(#halftone-sg-th)"/>

  <!-- Scheming Dark Cloud & Purple Trick Question Mark -->
  <g transform="translate(210, 60)" filter="url(#glow-purple-sg)">
    <!-- Little storm cloud -->
    <path d="M -15 0 Q -25 -10 -15 -20 Q 0 -25 15 -18 Q 25 -8 15 0 Z" fill="#64748b" opacity="0.8"/>
    <text x="0" y="8" font-family="'Noto Serif TC', serif" font-weight="900" font-size="28" fill="#a855f7" text-anchor="middle">？</text>
  </g>

  <!-- Chubby Tiger resting -->
  <g id="spotted-tiger" transform="translate(195, 195)" filter="url(#comic-shadow-sg)">
    <ellipse cx="0" cy="10" rx="28" ry="20" fill="#facc15" stroke="#0f172a" stroke-width="3.5"/>
    <ellipse cx="-10" cy="5" rx="5" ry="3" fill="#0f172a"/>
    <circle cx="-15" cy="-2" r="14" fill="#facc15" stroke="#0f172a" stroke-width="3"/>
    <circle cx="-25" cy="-14" r="5" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
    <circle cx="-8" cy="-14" r="5" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
    <text x="-15" y="-5" font-family="sans-serif" font-weight="900" font-size="8" fill="#0f172a" text-anchor="middle">王</text>
    <path d="M -20 -1 Q -17 3 -14 -1" stroke="#0f172a" stroke-width="2" fill="none"/>
    <path d="M -12 -1 Q -9 3 -6 -1" stroke="#0f172a" stroke-width="2" fill="none"/>
  </g>

  <!-- Body -->
  <g id="body" filter="url(#comic-shadow-sg)">
    <path d="M 105 165 L 80 240 Q 140 255 200 240 L 175 165 Z" fill="url(#purple-robe-sg)" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <path d="M 98 195 Q 140 205 182 195 L 180 210 Q 140 220 100 210 Z" fill="#eab308" stroke="#0f172a" stroke-width="3.5"/>
    <circle cx="140" cy="204" r="8" fill="#7e22ce" stroke="#0f172a" stroke-width="2.5"/>
    <ellipse cx="115" cy="245" rx="14" ry="7" fill="#0f172a"/>
    <ellipse cx="165" cy="245" rx="14" ry="7" fill="#0f172a"/>
  </g>

  <!-- Arms: Fingers pinched in scheming calculation -->
  <g id="arms" filter="url(#comic-shadow-sg)">
    <!-- Right Hand pinching fingers -->
    <path d="M 175 175 Q 190 155 182 135" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 175 175 Q 190 155 182 135" stroke="#a855f7" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="182" cy="135" r="7" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>

    <!-- Left Hand stroking goatee -->
    <path d="M 100 175 Q 120 185 135 158" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 100 175 Q 120 185 135 158" stroke="#a855f7" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="135" cy="158" r="7" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Head Base -->
  <g id="hair-back" filter="url(#comic-shadow-sg)">
    <ellipse cx="140" cy="105" rx="58" ry="52" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
    <path d="M 125 55 L 120 20 L 160 20 L 155 55 Z" fill="#6b21a8" stroke="#0f172a" stroke-width="3.5"/>
    <ellipse cx="140" cy="20" rx="20" ry="6" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
  </g>

  <!-- Chibi Face -->
  <ellipse cx="140" cy="115" rx="50" ry="44" fill="url(#skin-sg)" stroke="#0f172a" stroke-width="4.5" filter="url(#comic-shadow-sg)"/>

  <!-- Comic Sweat drop -->
  <path d="M 85 95 Q 80 108 88 110 Q 94 108 90 95 Z" fill="#38bdf8" stroke="#0f172a" stroke-width="2"/>

  <!-- Bangs -->
  <path d="M 94 92 Q 112 108 125 94 L 140 102 L 155 94 Q 168 108 186 92 Q 140 75 94 92 Z" fill="#0f172a"/>

  <!-- Comic Squinting Scheming Eyes (一條線計算眼) -->
  <g id="eyes">
    <line x1="106" y1="108" x2="130" y2="108" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>
    <line x1="150" y1="108" x2="174" y2="108" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>
  </g>

  <!-- Asymmetric Scheming Brows -->
  <path d="M 102 96 L 128 90" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>
  <path d="M 178 90 L 152 96" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>

  <!-- Handlebar Mustache -->
  <g id="mustache" filter="url(#comic-shadow-sg)">
    <path d="M 138 126 Q 110 125 95 138 Q 115 134 136 130 Z" fill="#0f172a" stroke="#0f172a" stroke-width="2.5"/>
    <path d="M 142 126 Q 170 125 185 138 Q 165 134 144 130 Z" fill="#0f172a" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Grinning Wavy Smirk (奸笑嘴角) -->
  <path d="M 132 134 Q 140 130 148 136" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" fill="none"/>
  <polygon points="137,144 143,144 140,154" fill="#0f172a"/>
</svg>
