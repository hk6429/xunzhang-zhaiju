<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 280" width="280" height="280">
  <defs>
    <filter id="comic-shadow-sg" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="5" stdDeviation="0" flood-color="#0f172a" flood-opacity="0.8" />
    </filter>
    <filter id="glow-purple-sg" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="4" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
    <linearGradient id="purple-robe-sg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f3e8ff"/>
      <stop offset="50%" stop-color="#a855f7"/>
      <stop offset="100%" stop-color="#6b21a8"/>
    </linearGradient>
    <linearGradient id="skin-sg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff5f5"/>
      <stop offset="100%" stop-color="#fed7aa"/>
    </linearGradient>
  </defs>

  <!-- Dark Purple Comic Action Speedlines -->
  <g stroke="#a855f7" stroke-width="2.5" opacity="0.6" stroke-linecap="round">
    <line x1="140" y1="140" x2="20" y2="20"/>
    <line x1="140" y1="140" x2="80" y2="10"/>
    <line x1="140" y1="140" x2="200" y2="10"/>
    <line x1="140" y1="140" x2="260" y2="25"/>
    <line x1="140" y1="140" x2="270" y2="90"/>
    <line x1="140" y1="140" x2="260" y2="240"/>
    <line x1="140" y1="140" x2="20" y2="240"/>
  </g>

  <!-- Yin-Yang Mirror Beams Shooting Skyward -->
  <g transform="translate(225, 80) rotate(-25)" filter="url(#glow-purple-sg)">
    <line x1="0" y1="0" x2="0" y2="-70" stroke="#facc15" stroke-width="8" stroke-linecap="round"/>
    <line x1="0" y1="0" x2="0" y2="-70" stroke="#ffffff" stroke-width="3" stroke-linecap="round"/>
    <circle cx="0" cy="0" r="20" fill="#facc15" stroke="#0f172a" stroke-width="3"/>
  </g>

  <!-- Chubby Tiger Roaring Proudly (神氣咆哮) -->
  <g id="spotted-tiger" transform="translate(60, 205)" filter="url(#comic-shadow-sg)">
    <ellipse cx="0" cy="10" rx="26" ry="18" fill="#facc15" stroke="#0f172a" stroke-width="3.5"/>
    <ellipse cx="-5" cy="5" rx="5" ry="3" fill="#0f172a"/>
    <circle cx="15" cy="-2" r="14" fill="#facc15" stroke="#0f172a" stroke-width="3"/>
    <circle cx="25" cy="-14" r="5" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
    <circle cx="8" cy="-14" r="5" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
    <!-- Roaring Open Tiger Mouth -->
    <ellipse cx="18" cy="4" rx="6" ry="4" fill="#dc2626"/>
    <!-- Tiny Tiger Fangs -->
    <polygon points="14,1 16,5 18,1" fill="#ffffff"/>
    <!-- Joyful Eyes (^^) -->
    <path d="M 10 -4 Q 14 -8 18 -4" stroke="#0f172a" stroke-width="2" fill="none"/>
  </g>

  <!-- Body -->
  <g id="body" filter="url(#comic-shadow-sg)">
    <path d="M 105 165 L 80 235 Q 140 250 200 235 L 175 165 Z" fill="url(#purple-robe-sg)" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <path d="M 98 190 Q 140 200 182 190 L 180 205 Q 140 215 100 205 Z" fill="#eab308" stroke="#0f172a" stroke-width="3.5"/>
    <circle cx="140" cy="198" r="8" fill="#7e22ce" stroke="#0f172a" stroke-width="2.5"/>
    <ellipse cx="115" cy="242" rx="14" ry="7" fill="#0f172a"/>
    <ellipse cx="165" cy="242" rx="14" ry="7" fill="#0f172a"/>
  </g>

  <!-- Raised Arms Laughing in Triumph -->
  <g id="arms" filter="url(#comic-shadow-sg)">
    <!-- Left Hand Hands on hips / raised -->
    <path d="M 100 170 Q 75 145 90 120" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 100 170 Q 75 145 90 120" stroke="#a855f7" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="90" cy="120" r="7.5" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>

    <!-- Right Hand raising mirror high -->
    <path d="M 175 170 Q 205 140 215 105" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 175 170 Q 205 140 215 105" stroke="#a855f7" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="215" cy="105" r="7.5" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Head Base -->
  <g id="hair-back" filter="url(#comic-shadow-sg)">
    <ellipse cx="140" cy="105" rx="58" ry="52" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
    <path d="M 125 55 L 120 20 L 160 20 L 155 55 Z" fill="#6b21a8" stroke="#0f172a" stroke-width="3.5"/>
    <ellipse cx="140" cy="20" rx="20" ry="6" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
  </g>

  <!-- Chibi Face -->
  <ellipse cx="140" cy="115" rx="50" ry="44" fill="url(#skin-sg)" stroke="#0f172a" stroke-width="4.5" filter="url(#comic-shadow-sg)"/>

  <!-- Bangs -->
  <path d="M 94 92 Q 112 108 125 94 L 140 102 L 155 94 Q 168 108 186 92 Q 140 75 94 92 Z" fill="#0f172a"/>

  <!-- Maniacal Laughing Eyes (Closed upside-down curves with evil sparkle) -->
  <g id="eyes">
    <path d="M 106 106 Q 118 94 130 106" stroke="#0f172a" stroke-width="5" stroke-linecap="round" fill="none"/>
    <path d="M 150 106 Q 162 94 174 106" stroke="#0f172a" stroke-width="5" stroke-linecap="round" fill="none"/>
  </g>

  <!-- High Raised Villain Brows -->
  <path d="M 102 86 Q 118 78 130 86" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round" fill="none"/>
  <path d="M 178 86 Q 162 78 150 86" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round" fill="none"/>
  </g>

  <!-- Handlebar Mustache Raised High with Joy -->
  <g id="mustache" filter="url(#comic-shadow-sg)">
    <path d="M 138 122 Q 110 115 90 130 Q 115 128 136 126 Z" fill="#0f172a" stroke="#0f172a" stroke-width="2.5"/>
    <path d="M 142 122 Q 170 115 190 130 Q 165 128 144 126 Z" fill="#0f172a" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Huge Villain Open Laughing Mouth ("桀桀桀！") -->
  <g id="mouth">
    <path d="M 124 124 Q 140 112 156 124 Q 140 152 124 124 Z" fill="#7e22ce" stroke="#0f172a" stroke-width="3.5" stroke-linejoin="round"/>
    <path d="M 132 138 Q 140 130 148 138" fill="#fda4af"/>
    <!-- Gold Tooth (大金牙) -->
    <rect x="136" y="122" width="5" height="5" fill="#facc15"/>
  </g>
  <polygon points="137,152 143,152 140,162" fill="#0f172a"/>
</svg>
