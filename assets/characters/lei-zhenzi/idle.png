<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 280" width="280" height="280">
  <defs>
    <pattern id="halftone-lz" width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="1.1" fill="#0d9488" opacity="0.18"/>
    </pattern>
    <filter id="comic-shadow-lz" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="5" stdDeviation="0" flood-color="#0f172a" flood-opacity="0.8" />
    </filter>
    <filter id="glow-thunder-lz" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3.5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
    <linearGradient id="wing-grad-lz" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#2dd4bf"/>
      <stop offset="50%" stop-color="#0d9488"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>
    <linearGradient id="skin-lz" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ccfbf1"/>
      <stop offset="100%" stop-color="#5eead4"/>
    </linearGradient>
  </defs>

  <!-- Teal / Lightning Halftone Background -->
  <circle cx="140" cy="140" r="125" fill="#f0fdfa" opacity="0.6"/>
  <circle cx="140" cy="140" r="115" fill="url(#halftone-lz)"/>

  <!-- Ink Splatters & Gold Lightning Sparks -->
  <path d="M 28 65 Q 15 85 38 90 Z" fill="#0f172a" opacity="0.8"/>
  <g filter="url(#glow-thunder-lz)">
    <path d="M 40 40 L 48 55 L 42 60 L 52 75" stroke="#facc15" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M 235 45 L 225 60 L 232 65 L 222 80" stroke="#facc15" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </g>

  <!-- Giant Wind-Thunder Ink Wings (風雷雙翼) in Back -->
  <g id="wings" filter="url(#comic-shadow-lz)">
    <!-- Left Wing -->
    <path d="M 120 160 C 70 120 20 80 15 40 C 25 70 50 110 35 130 C 50 125 70 145 65 170 C 80 160 100 170 110 180 Z" fill="url(#wing-grad-lz)" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <!-- Right Wing -->
    <path d="M 160 160 C 210 120 260 80 265 40 C 255 70 230 110 245 130 C 230 125 210 145 215 170 C 200 160 180 170 170 180 Z" fill="url(#wing-grad-lz)" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
  </g>

  <!-- Body (Tiger-striped Shorts & Thunder Vest) -->
  <g id="body" filter="url(#comic-shadow-lz)">
    <!-- Tiger Shorts -->
    <path d="M 110 200 L 95 240 L 130 240 L 140 215 L 150 240 L 185 240 L 170 200 Z" fill="#f59e0b" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <!-- Stripes -->
    <polygon points="100,215 115,220 102,228" fill="#0f172a"/>
    <polygon points="178,215 165,220 176,228" fill="#0f172a"/>
    <!-- Jade Armor Vest -->
    <path d="M 115 165 Q 140 180 165 165 L 175 205 Q 140 215 105 205 Z" fill="#0d9488" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <circle cx="140" cy="185" r="7" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
    <!-- Bird Talons / Little Shoes -->
    <ellipse cx="112" cy="245" rx="14" ry="7" fill="#0f172a"/>
    <ellipse cx="168" cy="245" rx="14" ry="7" fill="#0f172a"/>
  </g>

  <!-- Arms holding Wind-Thunder Chisels (風雷雙錐) -->
  <!-- Left Hand holding Gold Chisel -->
  <g id="arm-left" filter="url(#comic-shadow-lz)">
    <path d="M 105 170 Q 75 165 65 145" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 105 170 Q 75 165 65 145" stroke="url(#skin-lz)" stroke-width="6" stroke-linecap="round" fill="none"/>
    <circle cx="65" cy="145" r="7" fill="#5eead4" stroke="#0f172a" stroke-width="2.5"/>
    <!-- Chisel -->
    <path d="M 65 165 L 65 120" stroke="#facc15" stroke-width="6" stroke-linecap="round"/>
    <polygon points="61,120 69,120 65,110" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
  </g>

  <!-- Right Hand holding Thunder Mallet (雷公槌) -->
  <g id="arm-right" filter="url(#comic-shadow-lz)">
    <path d="M 175 170 Q 205 165 215 145" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 175 170 Q 205 165 215 145" stroke="url(#skin-lz)" stroke-width="6" stroke-linecap="round" fill="none"/>
    <circle cx="215" cy="145" r="7" fill="#5eead4" stroke="#0f172a" stroke-width="2.5"/>
    <!-- Mallet -->
    <line x1="215" y1="165" x2="215" y2="125" stroke="#78350f" stroke-width="4.5" stroke-linecap="round"/>
    <rect x="202" y="120" width="26" height="14" rx="3" fill="#facc15" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Head Base (Cyan Chibi Face with Wild Spiky Hair) -->
  <g id="hair-back" filter="url(#comic-shadow-lz)">
    <ellipse cx="140" cy="100" rx="56" ry="52" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
    <!-- Wild Spikes (怒髮衝冠帶電) -->
    <polygon points="120,60 110,25 130,55" fill="#f59e0b" stroke="#0f172a" stroke-width="2.5"/>
    <polygon points="135,55 140,15 148,55" fill="#facc15" stroke="#0f172a" stroke-width="2.5"/>
    <polygon points="150,55 165,22 160,60" fill="#f59e0b" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Cyan Green Cute Chibi Face -->
  <ellipse cx="140" cy="112" rx="48" ry="42" fill="url(#skin-lz)" stroke="#0f172a" stroke-width="4.5" filter="url(#comic-shadow-lz)"/>

  <!-- Golden Third Eye / Forehead Lightning Rune -->
  <g transform="translate(140, 84)" filter="url(#glow-thunder-lz)">
    <polygon points="0,-8 4,0 -1,1 3,8 -3,0 1,-1" fill="#facc15" stroke="#ca8a04" stroke-width="1.5"/>
  </g>

  <!-- Bangs -->
  <path d="M 96 90 Q 115 105 125 92 L 140 100 L 155 92 Q 165 105 184 90 Q 140 70 96 90 Z" fill="#0f172a"/>

  <!-- Golden Sparkly Big Eyes (金睛萌眼) -->
  <g id="eyes">
    <!-- Left Eye -->
    <ellipse cx="118" cy="110" rx="11" ry="12" fill="#0f172a"/>
    <circle cx="118" cy="110" r="9" fill="#facc15"/>
    <circle cx="115" cy="106" r="4.5" fill="#ffffff"/>
    <circle cx="121" cy="114" r="2" fill="#ffffff"/>

    <!-- Right Eye -->
    <ellipse cx="162" cy="110" rx="11" ry="12" fill="#0f172a"/>
    <circle cx="162" cy="110" r="9" fill="#facc15"/>
    <circle cx="159" cy="106" r="4.5" fill="#ffffff"/>
    <circle cx="165" cy="114" r="2" fill="#ffffff"/>
  </g>

  <!-- Energetic Brows -->
  <path d="M 102 92 L 128 86" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>
  <path d="M 178 92 L 152 86" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>

  <!-- Cute Golden Bird Beak Mouth (呆萌鳥嘴小金剛) -->
  <g id="bird-beak" filter="url(#comic-shadow-lz)">
    <!-- Upper Beak -->
    <path d="M 130 122 Q 140 115 150 122 L 140 134 Z" fill="#facc15" stroke="#0f172a" stroke-width="3"/>
    <!-- Lower Beak -->
    <path d="M 133 125 L 140 138 L 147 125 Z" fill="#ca8a04" stroke="#0f172a" stroke-width="2.5"/>
  </g>
</svg>
