<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 280" width="280" height="280">
  <defs>
    <filter id="comic-shadow-lz" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="5" stdDeviation="0" flood-color="#0f172a" flood-opacity="0.8" />
    </filter>
    <filter id="glow-thunder-lz" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="4" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
    <linearGradient id="wing-grad-lz" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#2dd4bf"/>
      <stop offset="50%" stop-color="#0d9488"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>
    <linearGradient id="skin-lz" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ccfbf1"/>
      <stop offset="100%" stop-color="#5eead4"/>
    </linearGradient>
  </defs>

  <!-- Epic Thunder Action Burst Radial Lines -->
  <g stroke="#facc15" stroke-width="2.5" opacity="0.6" stroke-linecap="round">
    <line x1="140" y1="140" x2="20" y2="20"/>
    <line x1="140" y1="140" x2="80" y2="10"/>
    <line x1="140" y1="140" x2="200" y2="10"/>
    <line x1="140" y1="140" x2="260" y2="25"/>
    <line x1="140" y1="140" x2="270" y2="90"/>
    <line x1="140" y1="140" x2="265" y2="170"/>
    <line x1="140" y1="140" x2="260" y2="240"/>
    <line x1="140" y1="140" x2="20" y2="240"/>
  </g>

  <!-- Giant Lightning Bolt Striking Through Center (九天玄雷劈下) -->
  <g filter="url(#glow-thunder-lz)">
    <path d="M 140 0 L 125 45 L 145 55 L 115 110 L 135 115 L 90 190" stroke="#facc15" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M 140 0 L 125 45 L 145 55 L 115 110 L 135 115 L 90 190" stroke="#ffffff" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </g>

  <!-- Huge Spread Wings (雙翼大展) -->
  <g id="wings" filter="url(#comic-shadow-lz)">
    <!-- Left Wing soaring high -->
    <path d="M 120 150 C 60 90 10 40 5 10 C 20 50 45 90 25 120 C 45 115 65 135 60 160 C 80 150 100 160 110 170 Z" fill="url(#wing-grad-lz)" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <!-- Right Wing soaring high -->
    <path d="M 160 150 C 220 90 270 40 275 10 C 260 50 235 90 255 120 C 235 115 215 135 220 160 C 200 150 180 160 170 170 Z" fill="url(#wing-grad-lz)" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
  </g>

  <!-- Body -->
  <g id="body" filter="url(#comic-shadow-lz)">
    <path d="M 110 195 L 90 235 L 125 235 L 140 210 L 155 235 L 190 235 L 170 195 Z" fill="#f59e0b" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <path d="M 115 160 Q 140 175 165 160 L 175 200 Q 140 210 105 200 Z" fill="#0d9488" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round"/>
    <circle cx="140" cy="180" r="7" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
    <ellipse cx="108" cy="240" rx="14" ry="7" fill="#0f172a"/>
    <ellipse cx="172" cy="240" rx="14" ry="7" fill="#0f172a"/>
  </g>

  <!-- Arms Crashing Chisels Together in Mid-air to produce Lightning -->
  <g id="arms" filter="url(#comic-shadow-lz)">
    <path d="M 105 165 Q 120 120 135 95" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 105 165 Q 120 120 135 95" stroke="url(#skin-lz)" stroke-width="6" stroke-linecap="round" fill="none"/>
    <circle cx="135" cy="95" r="7.5" fill="#5eead4" stroke="#0f172a" stroke-width="2.5"/>

    <path d="M 175 165 Q 160 120 145 95" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 175 165 Q 160 120 145 95" stroke="url(#skin-lz)" stroke-width="6" stroke-linecap="round" fill="none"/>
    <circle cx="145" cy="95" r="7.5" fill="#5eead4" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Head Base -->
  <g id="hair-back" filter="url(#comic-shadow-lz)">
    <ellipse cx="140" cy="100" rx="56" ry="52" fill="#0f172a" stroke="#0f172a" stroke-width="4"/>
    <polygon points="120,60 110,25 130,55" fill="#f59e0b" stroke="#0f172a" stroke-width="2.5"/>
    <polygon points="135,55 140,15 148,55" fill="#facc15" stroke="#0f172a" stroke-width="2.5"/>
    <polygon points="150,55 165,22 160,60" fill="#f59e0b" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- Cyan Green Cute Chibi Face -->
  <ellipse cx="140" cy="112" rx="48" ry="42" fill="url(#skin-lz)" stroke="#0f172a" stroke-width="4.5" filter="url(#comic-shadow-lz)"/>

  <!-- Glowing Lightning Mark on Forehead -->
  <g transform="translate(140, 84)" filter="url(#glow-thunder-lz)">
    <polygon points="0,-9 5,0 -1,1 4,9 -4,0 1,-1" fill="#ffffff" stroke="#facc15" stroke-width="1.5"/>
  </g>

  <!-- Bangs -->
  <path d="M 96 90 Q 115 105 125 92 L 140 100 L 155 92 Q 165 105 184 90 Q 140 70 96 90 Z" fill="#0f172a"/>

  <!-- Victorious Burning Eyes (>< Joyful Eyes with golden stars) -->
  <g id="eyes">
    <path d="M 108 108 Q 120 94 132 108" stroke="#0f172a" stroke-width="5" stroke-linecap="round" fill="none"/>
    <path d="M 148 108 Q 160 94 172 108" stroke="#0f172a" stroke-width="5" stroke-linecap="round" fill="none"/>
    <circle cx="120" cy="116" r="3" fill="#facc15"/>
    <circle cx="160" cy="116" r="3" fill="#facc15"/>
  </g>

  <!-- Excited Raised Brows -->
  <path d="M 102 88 Q 118 80 130 88" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round" fill="none"/>
  <path d="M 178 88 Q 162 80 150 88" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round" fill="none"/>

  <!-- Open Cheerful Bird Beak Mouth (雀躍張嘴大笑) -->
  <g id="bird-beak" filter="url(#comic-shadow-lz)">
    <path d="M 128 118 Q 140 108 152 118 L 140 130 Z" fill="#facc15" stroke="#0f172a" stroke-width="3"/>
    <path d="M 132 128 L 140 144 L 148 128 Z" fill="#e11d48" stroke="#0f172a" stroke-width="2.5"/>
  </g>
</svg>
