<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 240" width="240" height="240">
  <defs>
    <filter id="ink-shadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="5" stdDeviation="4" flood-color="#1c1917" flood-opacity="0.18" />
    </filter>
    <linearGradient id="skin-grad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff5f5"/>
      <stop offset="100%" stop-color="#fed7aa"/>
    </linearGradient>
    <radialGradient id="blush-grad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#fb7185" stop-opacity="0.5"/>
      <stop offset="100%" stop-color="#fb7185" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="robe-grad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#38bdf8"/>
      <stop offset="100%" stop-color="#0284c7"/>
    </linearGradient>
    <linearGradient id="sweat-grad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#e0f2fe"/>
      <stop offset="100%" stop-color="#38bdf8"/>
    </linearGradient>
  </defs>
  <g id="moling-panic">
    <!-- Huge Anime Sweatdrops -->
    <path d="M 52 75 C 48 70 42 78 46 86 C 50 94 58 92 60 86 C 62 80 56 80 52 75 Z" fill="url(#sweat-grad)" stroke="#0284c7" stroke-width="1.5" filter="url(#ink-shadow)"/>
    <path d="M 188 75 C 192 70 198 78 194 86 C 190 94 182 92 180 86 C 178 80 184 80 188 75 Z" fill="url(#sweat-grad)" stroke="#0284c7" stroke-width="1.5" filter="url(#ink-shadow)"/>
    <!-- Panic Vertical Lines -->
    <line x1="88" y1="36" x2="88" y2="52" stroke="#3b82f6" stroke-width="3" stroke-linecap="round"/>
    <line x1="96" y1="32" x2="96" y2="50" stroke="#3b82f6" stroke-width="3" stroke-linecap="round"/>
    <line x1="144" y1="32" x2="144" y2="50" stroke="#3b82f6" stroke-width="3" stroke-linecap="round"/>
    <line x1="152" y1="36" x2="152" y2="52" stroke="#3b82f6" stroke-width="3" stroke-linecap="round"/>

    <!-- Floating Cloud shaking -->
    <ellipse cx="120" cy="222" rx="36" ry="8" fill="#0f172a" opacity="0.15"/>
    <path d="M 78 220 Q 95 210 115 218 Q 135 208 162 220 Q 140 228 120 225 Q 95 228 78 220 Z" fill="#e0f2fe" opacity="0.8"/>

    <!-- Robe Body -->
    <path d="M 90 148 L 70 214 C 70 218 170 218 170 214 L 150 148 Z" fill="url(#robe-grad)" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round" filter="url(#ink-shadow)"/>
    <path d="M 96 148 L 120 180 L 144 148" fill="#f8fafc" stroke="#0f172a" stroke-width="3.5"/>
    <path d="M 76 184 Q 120 192 164 184" stroke="#facc15" stroke-width="5.5" fill="none" stroke-linecap="round"/>
    <circle cx="120" cy="186" r="6" fill="#ef4444" stroke="#0f172a" stroke-width="2"/>

    <!-- Shaking Feet -->
    <ellipse cx="98" cy="216" rx="8" ry="4.5" fill="#0f172a"/>
    <ellipse cx="142" cy="216" rx="8" ry="4.5" fill="#0f172a"/>

    <!-- Arms Waving in Panic! -->
    <!-- Left Hand waving on head -->
    <path d="M 90 152 Q 62 120 72 95" stroke="#0f172a" stroke-width="5" fill="none" stroke-linecap="round"/>
    <circle cx="72" cy="95" r="7" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>

    <!-- Right Hand waving in air dropping brush -->
    <path d="M 150 152 Q 178 120 168 95" stroke="#0f172a" stroke-width="5" fill="none" stroke-linecap="round"/>
    <circle cx="168" cy="95" r="7" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>

    <!-- Dropping Brush falling -->
    <g transform="rotate(75 190 170)">
      <rect x="186" y="140" width="6" height="70" rx="3" fill="#b45309" stroke="#0f172a" stroke-width="2"/>
      <path d="M 184 136 Q 189 115 189 112 Q 190 115 194 136 Z" fill="#0f172a"/>
    </g>

    <!-- Chibi Head -->
    <ellipse cx="120" cy="100" rx="46" ry="42" fill="url(#skin-grad)" stroke="#0f172a" stroke-width="4.5" filter="url(#ink-shadow)"/>

    <!-- Flushed cheeks -->
    <ellipse cx="86" cy="108" rx="9" ry="5.5" fill="url(#blush-grad)"/>
    <ellipse cx="154" cy="108" rx="9" ry="5.5" fill="url(#blush-grad)"/>

    <!-- Forehead Inkdrop Mark -->
    <path d="M 120 74 C 117 78 115 82 115 84 C 115 87 117.2 89 120 89 C 122.8 89 125 87 125 84 C 125 82 123 78 120 74 Z" fill="#0284c7"/>

    <!-- Wavy Panic Eyebrows (><) -->
    <path d="M 92 84 Q 100 89 108 82" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" fill="none"/>
    <path d="M 132 82 Q 140 89 148 84" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" fill="none"/>

    <!-- Spiral Dizzy Eyes (蚊香眼) -->
    <g transform="translate(102, 98)" fill="none" stroke="#0f172a" stroke-width="2.2" stroke-linecap="round">
      <path d="M 0 0 A 2 2 0 0 1 2 2 A 4 4 0 0 1 -2 4 A 6 6 0 0 1 -6 -2 A 8 8 0 0 1 2 -8 A 10 10 0 0 1 10 2" />
    </g>
    <g transform="translate(138, 98)" fill="none" stroke="#0f172a" stroke-width="2.2" stroke-linecap="round">
      <path d="M 0 0 A 2 2 0 0 1 2 2 A 4 4 0 0 1 -2 4 A 6 6 0 0 1 -6 -2 A 8 8 0 0 1 2 -8 A 10 10 0 0 1 10 2" />
    </g>

    <!-- Wavy Open Scream Mouth -->
    <path d="M 110 114 Q 115 110 120 116 Q 125 122 130 114 Q 125 128 120 124 Q 115 128 110 114 Z" fill="#ef4444" stroke="#0f172a" stroke-width="2.5"/>

    <!-- Hair & Buns -->
    <path d="M 74 98 C 68 67 96 48 120 48 C 144 48 172 67 166 98 C 158 78 142 60 120 60 C 98 60 82 78 74 98 Z" fill="#0f172a"/>
    <path d="M 94 64 Q 106 80 120 64 Q 134 80 146 64" fill="#0f172a"/>
    <circle cx="92" cy="44" r="14" fill="#0f172a" stroke="#0f172a" stroke-width="2"/>
    <circle cx="148" cy="44" r="14" fill="#0f172a" stroke="#0f172a" stroke-width="2"/>
    <!-- Wild tangled ribbons -->
    <path d="M 82 48 Q 66 60 68 76" stroke="#ef4444" stroke-width="3" fill="none" stroke-linecap="round"/>
    <path d="M 158 48 Q 174 60 172 76" stroke="#ef4444" stroke-width="3" fill="none" stroke-linecap="round"/>
    <circle cx="92" cy="50" r="4" fill="#facc15"/>
    <circle cx="148" cy="50" r="4" fill="#facc15"/>
  </g>
</svg>
