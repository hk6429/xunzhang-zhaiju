<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 240" width="240" height="240">
  <defs>
    <filter id="ink-shadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="5" stdDeviation="4" flood-color="#1c1917" flood-opacity="0.18" />
    </filter>
    <linearGradient id="skin-grad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff5f5"/>
      <stop offset="100%" stop-color="#fed7aa"/>
    </linearGradient>
    <radialGradient id="blush-grad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#fb7185" stop-opacity="0.45"/>
      <stop offset="100%" stop-color="#fb7185" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="robe-grad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#38bdf8"/>
      <stop offset="100%" stop-color="#0284c7"/>
    </linearGradient>
    <linearGradient id="ink-drop-grad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#475569"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>
  </defs>
  <g id="moling-idle">
    <!-- Floating Ink Cloud Base -->
    <ellipse cx="120" cy="220" rx="36" ry="9" fill="#0f172a" opacity="0.15"/>
    <path d="M 80 220 Q 95 210 115 218 Q 135 208 160 220 Q 140 228 120 225 Q 95 228 80 220 Z" fill="#e0f2fe" opacity="0.8"/>

    <!-- Robe Body -->
    <path d="M 90 148 L 72 212 C 72 216 168 216 168 212 L 150 148 Z" fill="url(#robe-grad)" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round" filter="url(#ink-shadow)"/>
    <!-- Collar & Belt -->
    <path d="M 96 148 L 120 180 L 144 148" fill="#f8fafc" stroke="#0f172a" stroke-width="3.5"/>
    <path d="M 78 184 Q 120 192 162 184" stroke="#facc15" stroke-width="5.5" fill="none" stroke-linecap="round"/>
    <circle cx="120" cy="186" r="6" fill="#ef4444" stroke="#0f172a" stroke-width="2"/>

    <!-- Small Feet -->
    <ellipse cx="102" cy="214" rx="8" ry="4.5" fill="#0f172a"/>
    <ellipse cx="138" cy="214" rx="8" ry="4.5" fill="#0f172a"/>

    <!-- Left Arm holding Ink Stone -->
    <path d="M 90 156 Q 68 166 64 150" stroke="#0f172a" stroke-width="4.5" fill="none" stroke-linecap="round"/>
    <circle cx="64" cy="150" r="6.5" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>
    <!-- Tiny Inkstone -->
    <rect x="46" y="142" width="18" height="14" rx="3" fill="#1e293b" stroke="#0f172a" stroke-width="2"/>
    <ellipse cx="55" cy="149" rx="5" ry="3.5" fill="#0284c7"/>

    <!-- Right Arm holding Giant Calligraphy Brush -->
    <path d="M 150 156 Q 172 166 176 148" stroke="#0f172a" stroke-width="4.5" fill="none" stroke-linecap="round"/>
    <circle cx="176" cy="148" r="6.5" fill="#fed7aa" stroke="#0f172a" stroke-width="2.5"/>
    <!-- Big Brush -->
    <g transform="rotate(22 176 148)">
      <rect x="172" y="80" width="7" height="90" rx="3.5" fill="#b45309" stroke="#0f172a" stroke-width="2.5"/>
      <rect x="170" y="76" width="11" height="8" rx="2" fill="#facc15" stroke="#0f172a" stroke-width="1.5"/>
      <path d="M 170 76 Q 175 48 175.5 45 Q 176 48 181 76 Z" fill="url(#ink-drop-grad)" stroke="#0f172a" stroke-width="2"/>
      <circle cx="175.5" cy="42" r="3" fill="#38bdf8" opacity="0.9"/>
    </g>

    <!-- Chibi Head -->
    <ellipse cx="120" cy="98" rx="46" ry="42" fill="url(#skin-grad)" stroke="#0f172a" stroke-width="4.5" filter="url(#ink-shadow)"/>

    <!-- Cheeks (Blushing) -->
    <ellipse cx="86" cy="106" rx="9" ry="5.5" fill="url(#blush-grad)"/>
    <ellipse cx="154" cy="106" rx="9" ry="5.5" fill="url(#blush-grad)"/>

    <!-- Forehead Inkdrop Mark -->
    <path d="M 120 74 C 117 78 115 82 115 84 C 115 87 117.2 89 120 89 C 122.8 89 125 87 125 84 C 125 82 123 78 120 74 Z" fill="#0284c7"/>

    <!-- Cute Big Round Eyes -->
    <!-- Left Eye -->
    <ellipse cx="102" cy="98" rx="9.5" ry="11" fill="#0f172a"/>
    <circle cx="100" cy="94" r="4.5" fill="#ffffff"/>
    <circle cx="104.5" cy="102" r="2" fill="#38bdf8"/>
    <!-- Right Eye -->
    <ellipse cx="138" cy="98" rx="9.5" ry="11" fill="#0f172a"/>
    <circle cx="136" cy="94" r="4.5" fill="#ffffff"/>
    <circle cx="140.5" cy="102" r="2" fill="#38bdf8"/>

    <!-- Smiling Mouth -->
    <path d="M 114 112 Q 120 118 126 112" stroke="#0f172a" stroke-width="3" stroke-linecap="round" fill="none"/>

    <!-- Hair & Double Bun (抓髻包包頭) with Red Ribbon -->
    <path d="M 74 96 C 68 65 96 46 120 46 C 144 46 172 65 166 96 C 158 76 142 58 120 58 C 98 58 82 76 74 96 Z" fill="#0f172a"/>
    <!-- Bangs -->
    <path d="M 94 62 Q 106 78 120 62 Q 134 78 146 62" fill="#0f172a"/>
    <!-- Left Bun -->
    <circle cx="92" cy="42" r="14" fill="#0f172a" stroke="#0f172a" stroke-width="2"/>
    <circle cx="92" cy="48" r="4" fill="#facc15"/>
    <path d="M 82 46 Q 70 54 72 66" stroke="#ef4444" stroke-width="3.5" fill="none" stroke-linecap="round"/>
    <!-- Right Bun -->
    <circle cx="148" cy="42" r="14" fill="#0f172a" stroke="#0f172a" stroke-width="2"/>
    <circle cx="148" cy="48" r="4" fill="#facc15"/>
    <path d="M 158 46 Q 170 54 168 66" stroke="#ef4444" stroke-width="3.5" fill="none" stroke-linecap="round"/>
  </g>
</svg>
