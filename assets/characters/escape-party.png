<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="800" height="450">
  <defs>
    <pattern id="party-dots" width="12" height="12" patternUnits="userSpaceOnUse">
      <circle cx="6" cy="6" r="1.5" fill="#e11d48" opacity="0.12"/>
      <circle cx="12" cy="0" r="1.5" fill="#facc15" opacity="0.15"/>
    </pattern>
    <filter id="comic-shadow-lg" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="4" dy="6" stdDeviation="0" flood-color="#0f172a" flood-opacity="0.85" />
    </filter>
    <filter id="glow-gold-lg" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
    <linearGradient id="bg-party" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff1f2"/>
      <stop offset="50%" stop-color="#fdf4ff"/>
      <stop offset="100%" stop-color="#fefce8"/>
    </linearGradient>
    <linearGradient id="gold-banner" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#fef08a"/>
      <stop offset="50%" stop-color="#facc15"/>
      <stop offset="100%" stop-color="#ca8a04"/>
    </linearGradient>
  </defs>

  <!-- Festive Background -->
  <rect width="800" height="450" fill="url(#bg-party)"/>
  <rect width="800" height="450" fill="url(#party-dots)"/>

  <!-- Confetti & Celebration Streamers (彩帶與節慶碎紙) -->
  <g opacity="0.75">
    <path d="M 50 30 Q 80 80 60 120 Q 40 160 80 200" stroke="#f43f5e" stroke-width="4" fill="none"/>
    <path d="M 750 30 Q 720 80 740 120 Q 760 160 720 200" stroke="#38bdf8" stroke-width="4" fill="none"/>
    <path d="M 220 20 Q 250 60 230 100" stroke="#facc15" stroke-width="3" fill="none"/>
    <path d="M 580 20 Q 550 60 570 100" stroke="#a855f7" stroke-width="3" fill="none"/>
    <!-- Floating Gold Coins & Stars -->
    <circle cx="120" cy="80" r="7" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
    <circle cx="280" cy="60" r="6" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
    <circle cx="520" cy="60" r="6" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
    <circle cx="680" cy="80" r="7" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
  </g>

  <!-- TOP PARTY BANNER -->
  <g id="title-banner" filter="url(#comic-shadow-lg)">
    <path d="M 180 25 L 620 25 L 600 80 L 200 80 Z" fill="#0f172a"/>
    <path d="M 185 30 L 615 30 L 595 75 L 205 75 Z" fill="url(#gold-banner)"/>
    <text x="400" y="62" font-family="'Noto Serif TC', serif" font-weight="900" font-size="30" fill="#0f172a" text-anchor="middle" letter-spacing="6">🎉 密室狂歡・群仙大逃脫 🎉</text>
  </g>

  <!-- ==================== 1. TAIYI ZHENREN (Center) ==================== -->
  <g id="party-taiyi" transform="translate(400, 240)" filter="url(#comic-shadow-lg)">
    <!-- Wine Gourd Spouting Party Champagne & Rainbow Streamers -->
    <g transform="translate(-70, -30) rotate(-40)" filter="url(#glow-gold-lg)">
      <circle cx="0" cy="0" r="22" fill="#f59e0b" stroke="#0f172a" stroke-width="3.5"/>
      <circle cx="0" cy="-28" r="14" fill="#f59e0b" stroke="#0f172a" stroke-width="3"/>
      <!-- Wine Streamer Fountain -->
      <path d="M 0 -40 Q -30 -120 40 -160" stroke="#facc15" stroke-width="8" stroke-linecap="round" fill="none"/>
    </g>
    <!-- Big Chubby Body -->
    <ellipse cx="0" cy="50" rx="60" ry="44" fill="#fef3c7" stroke="#0f172a" stroke-width="5"/>
    <path d="M -50 60 Q 0 80 50 60" stroke="#dc2626" stroke-width="7" fill="none"/>
    <!-- Head -->
    <ellipse cx="0" cy="-25" rx="54" ry="46" fill="#fff5f5" stroke="#0f172a" stroke-width="5"/>
    <!-- Rosy Cheeks -->
    <ellipse cx="-38" cy="-15" rx="10" ry="7" fill="#fb7185"/>
    <ellipse cx="38" cy="-15" rx="10" ry="7" fill="#fb7185"/>
    <!-- Happy Eyes & Smile -->
    <path d="M -30 -30 Q -18 -44 -6 -30" stroke="#0f172a" stroke-width="5" stroke-linecap="round" fill="none"/>
    <path d="M 6 -30 Q 18 -44 30 -30" stroke="#0f172a" stroke-width="5" stroke-linecap="round" fill="none"/>
    <path d="M -18 -8 Q 0 5 18 -8 Q 0 20 -18 -8 Z" fill="#e11d48" stroke="#0f172a" stroke-width="3.5"/>
    <!-- Arms High in Air Holding Toast -->
    <path d="M -45 30 Q -80 0 -60 -40" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
    <path d="M 45 30 Q 80 0 60 -40" stroke="#0f172a" stroke-width="12" stroke-linecap="round" fill="none"/>
  </g>

  <!-- ==================== 2. SU DAJI (Left Center) ==================== -->
  <g id="party-daji" transform="translate(240, 240)" filter="url(#comic-shadow-lg)">
    <!-- Nine Tails Blooming with Hearts -->
    <path d="M -20 30 C -80 0 -90 -60 -70 -90 C -50 -60 -20 0 0 20 Z" fill="#fda4af" stroke="#0f172a" stroke-width="3"/>
    <path d="M 0 30 C -30 -30 -20 -90 0 -110 C 20 -90 20 -30 10 20 Z" fill="#fda4af" stroke="#0f172a" stroke-width="3"/>
    <!-- Body -->
    <path d="M -25 35 L -40 105 L 10 105 L 25 35 Z" fill="#db2777" stroke="#0f172a" stroke-width="4.5"/>
    <!-- Head & Fox Ears -->
    <ellipse cx="0" cy="-25" rx="46" ry="40" fill="#fff1f2" stroke="#0f172a" stroke-width="5"/>
    <polygon points="-40,-50 -55,-85 -25,-65" fill="#0f172a"/>
    <polygon points="40,-50 55,-85 25,-65" fill="#0f172a"/>
    <!-- Heart Eyes (❤❤) -->
    <path d="M -15 -25 C -15 -32 -22 -35 -27 -30 C -32 -35 -39 -32 -39 -25 C -39 -17 -27 -10 -27 -10 C -27 -10 -15 -17 -15 -25 Z" fill="#f43f5e"/>
    <path d="M 35 -25 C 35 -32 28 -35 23 -30 C 18 -35 11 -32 11 -25 C 11 -17 23 -10 23 -10 C 23 -10 35 -17 35 -25 Z" fill="#f43f5e"/>
    <!-- Charming Smile -->
    <path d="M -10 -5 Q 0 4 10 -5" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" fill="#e11d48"/>
  </g>

  <!-- ==================== 3. LEI ZHENZI (Right Center Soaring) ==================== -->
  <g id="party-leizhenzi" transform="translate(560, 220)" filter="url(#comic-shadow-lg)">
    <!-- Wings Spread -->
    <path d="M -30 10 C -80 -40 -120 -80 -130 -110 C -110 -70 -70 -30 -20 -10 Z" fill="#0d9488" stroke="#0f172a" stroke-width="4"/>
    <path d="M 30 10 C 80 -40 120 -80 130 -110 C 110 -70 70 -30 20 -10 Z" fill="#0d9488" stroke="#0f172a" stroke-width="4"/>
    <!-- Body -->
    <path d="M -20 30 L -30 95 L 20 95 L 10 30 Z" fill="#0d9488" stroke="#0f172a" stroke-width="4"/>
    <!-- Head -->
    <ellipse cx="0" cy="-25" rx="46" ry="40" fill="#5eead4" stroke="#0f172a" stroke-width="4.5"/>
    <!-- Lightning Spikes -->
    <polygon points="-15,-65 0,-95 15,-65" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
    <!-- Cheerful Eyes & Bird Beak -->
    <path d="M -24 -30 Q -12 -42 0 -30" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round" fill="none"/>
    <path d="M 0 -30 Q 12 -42 24 -30" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round" fill="none"/>
    <polygon points="-12,-15 12,-15 0,2" fill="#facc15" stroke="#0f172a" stroke-width="2.5"/>
  </g>

  <!-- ==================== 4. TUXING SUN (Bottom Center Burrowing out) ==================== -->
  <g id="party-tuxing" transform="translate(400, 370)" filter="url(#comic-shadow-lg)">
    <!-- Dirt Hole -->
    <ellipse cx="0" cy="20" rx="75" ry="24" fill="#713f12" stroke="#0f172a" stroke-width="4"/>
    <!-- Tuxing Sun emerging holding "通關" Banner -->
    <g transform="translate(0, -35)">
      <!-- Mole Hood -->
      <ellipse cx="0" cy="0" rx="42" ry="36" fill="#713f12" stroke="#0f172a" stroke-width="3.5"/>
      <circle cx="-28" cy="-25" r="10" fill="#854d0e"/>
      <circle cx="28" cy="-25" r="10" fill="#854d0e"/>
      <!-- Face -->
      <ellipse cx="0" cy="6" rx="34" ry="26" fill="#fff5f5" stroke="#0f172a" stroke-width="3"/>
      <!-- Happy Face -->
      <path d="M -18 -2 Q -10 -10 0 -2" stroke="#0f172a" stroke-width="3.5" fill="none"/>
      <path d="M 0 -2 Q 10 -10 18 -2" stroke="#0f172a" stroke-width="3.5" fill="none"/>
      <circle cx="0" cy="6" r="3" fill="#854d0e"/>
      <!-- Little Victory Banner Raised -->
      <g transform="translate(45, -30) rotate(15)" filter="url(#glow-gold-lg)">
        <line x1="0" y1="0" x2="0" y2="40" stroke="#78350f" stroke-width="3"/>
        <polygon points="0,0 45,10 0,20" fill="#facc15" stroke="#0f172a" stroke-width="2"/>
        <text x="18" y="14" font-family="'Noto Serif TC', serif" font-weight="900" font-size="10" fill="#dc2626">通關</text>
      </g>
    </g>
  </g>

  <!-- ==================== 5. SHEN GONGBAO & TIGER (Far Right Cheering) ==================== -->
  <g id="party-shen" transform="translate(710, 290)" filter="url(#comic-shadow-lg)">
    <!-- Fat Tiger Joyful -->
    <ellipse cx="-15" cy="40" rx="32" ry="22" fill="#facc15" stroke="#0f172a" stroke-width="3.5"/>
    <circle cx="-35" cy="25" r="14" fill="#facc15" stroke="#0f172a" stroke-width="3"/>
    <!-- Shen Gongbao on Tiger -->
    <ellipse cx="0" cy="-20" rx="36" ry="32" fill="#fff5f5" stroke="#0f172a" stroke-width="4"/>
    <path d="M -10 -52 L 10 -52 L 5 -35 L -5 -35 Z" fill="#6b21a8" stroke="#0f172a" stroke-width="2"/>
    <!-- Handlebar Mustache & Smirk -->
    <path d="M -15 -10 Q -30 -8 -40 2" stroke="#0f172a" stroke-width="3" fill="none"/>
    <path d="M 15 -10 Q 30 -8 40 2" stroke="#0f172a" stroke-width="3" fill="none"/>
    <path d="M -10 2 Q 0 10 10 2" stroke="#0f172a" stroke-width="3" fill="#e11d48"/>
  </g>
</svg>
